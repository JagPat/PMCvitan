{
  "name": "Vitan PMC",
  "install": "bash scripts/cloud-agent-install.sh",
  "start": "bash scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "api",
      "command": "pnpm --filter api start"
    },
    {
      "name": "web",
      "command": "pnpm dev"
    }
  ],
  "ports": [
    { "name": "web", "port": 5173 },
    { "name": "api", "port": 3000 }
  ]
}
