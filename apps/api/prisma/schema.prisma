// Vitan PMC — database schema (PostgreSQL via Prisma).
// Phase-7 Slice 1: the entities behind the project snapshot and the core
// mutations. Fields are aligned with the frontend domain model
// (apps/web / packages/shared) so the API returns shapes the client uses
// directly. Phase 7c-auth adds User (accounts + phone identity) and
// WorkerDevice (no-account device tokens). Media and offline-outbox tables
// arrive in later slices. See docs/DATA_MODEL.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DecisionStatus {
  pending
  approved
  change
  // Phase 6 task 4a — a published, never-approved decision the PMC takes back. TERMINAL
  // (a BEFORE UPDATE trigger refuses any transition out) and entered ONLY from a published
  // `pending` row (the entry trigger; register emptiness alone is not proof of never-approved
  // on legacy data). Riding the enum — not an orthogonal flag — is deliberate: every reader
  // keyed by DecisionStatus fails to compile until it answers for the new value.
  withdrawn
}

// Phase 6 task 4b expansion — the current holder and frozen approval tuple share this
// designation. `none` and the record-only workflow remain outside this database-only unit.
enum DeciderKind {
  client
  pmc
  member
}

enum ActivityStatus {
  not_started
  in_progress
  // Phase 1 Task 5: an engineer's completion CLAIM parks the activity here;
  // only the PMC's approval of the linked closing inspection writes `done`
  awaiting_signoff
  done
  blocked
}

enum GateState {
  ok
  wait
  fail
  na
}

enum InspectionResult {
  PASS
  FAIL
}

model Project {
  billVerifications BillVerification[]
  billCertificates BillCertificate[]
  sodExceptions SodException[]
  sodGrants SodGrant[]
  billDeductions BillDeduction[]
  billDeductionReleases BillDeductionRelease[]
  certifiedAcceptanceConsumption CertifiedAcceptanceConsumption[]
  certifiedMeasurementConsumption CertifiedMeasurementConsumption[]
  id           String   @id
  name         String
  short        String
  descriptor   String
  stage        String
  siteCode     String
  location     String   @default("") // site address / locality (free text)
  projStart    String
  projEnd      String
  // Real civil dates (Phase 0 Task 6). scheduleStartDate is the SCHEDULE ANCHOR —
  // the calendar day legacy day-offset 0 refers to (proven by characterization:
  // dayLabel(0) === '1 Jun'); display projStart/projEnd stay as legacy strings.
  scheduleStartDate DateTime? @db.Date
  scheduleEndDate   DateTime? @db.Date
  timeZone          String    @default("Asia/Kolkata")
  elapsedPct   Int
  todayDay     Int
  milestonePct Int
  createdAt    DateTime @default(now())
  archivedAt   DateTime? // soft-delete: hidden from listings/switcher/portfolio when set

  decisions     Decision[]
  activities    Activity[]
  inspections   Inspection[]
  dailyLogs     DailyLog[]
  notifications Notification[]
  users         User[]
  workerDevices WorkerDevice[]
  media         Media[]
  pushSubs      PushSubscription[]
  drawings      Drawing[]
  phases        Phase[]
  gateOverrides GateOverride[]
  // Tenant — NON-NULL since Phase 2 Task 4 (the event envelope's composite tenant key
  // (organizationId, projectId) references Project(orgId, id); a project cannot exist
  // without an org). Legacy null-org projects are backfilled by the migration's diagnostic,
  // which ABORTS rather than guess a tenant. @@unique([orgId, id]) is added in raw SQL.
  org           Org            @relation(fields: [orgId], references: [id])
  orgId         String
  memberships   Membership[]
  companies     ProjectCompany[]
  // Phase 6 unit 6.1a (§A) — the org-bound side of the same rows, and the canonical
  // per-project party associations the collaborator resolver reads.
  projectParties ProjectParty[]  @relation("projectPartyProject")
  nodes         ProjectNode[]
  siteMaterials SiteMaterial[]
  eventStream   ProjectEventStream?
  domainEvents  DomainEvent[]

  // Composite identity the DomainEvent tenant FK references (Phase 2 Task 4) — proves an
  // event's (organizationId, projectId) is the project's REAL org, so org cannot be forged.
  @@unique([orgId, id])
  capabilities     ProjectCapability[]
  requirements     ActivityRequirement[]
  requirementRoots ActivityRequirementRoot[]
  materialSpecs    MaterialRequirementSpec[]
  approvedSubstitutions ApprovedSubstitution[]
  vendorBindings   ProjectVendor[]           @relation("projectVendorProject")
  requisitions     Requisition[]
  purchaseOrders   PurchaseOrder[]           @relation("purchaseOrderProject")
  stockLots           StockLot[]
  stockTransactions   StockTransaction[]
  materialIssues      MaterialIssue[]
  mismatchResolutions MismatchResolution[]
  // Phase 4 Task 1 — the labour module's project-contained rows (plan §§B/H)
  labourTrades          LabourTrade[]
  labourSkills          LabourSkill[]
  workers               Worker[]
  crews                 Crew[]
  crewMemberships       CrewMembership[]
  labourRequirementSpecs LabourRequirementSpec[]
  labourDemandSlices     LabourDemandSlice[]
  // Phase 4 Task 3 — the §C time-capacity facts (project-contained)
  workerAllocations         WorkerAllocation[]
  labourAttendance          LabourAttendance[]
  labourWorkFacts           LabourWorkFact[]
  labourMismatches          LabourMismatch[]
  labourMismatchResolutions LabourMismatchResolution[]
  activityWorkOutputs       ActivityWorkOutput[]
  approvedSkillSubstitutions ApprovedSkillSubstitution[]
  // Phase 5 Task 1 — the commercial cost-head catalog + commitment attributions (§C/§L)
  costHeads                 CostHead[]
  commitmentAttributions    CommitmentAttribution[]
  budgetLines               BudgetLine[]
  budgetExceptions          BudgetException[]
  measurements      Measurement[]
  // Phase 5 Task 4 (§F) — the vendor claim
  vendorBills        VendorBill[]
  vendorBillVersions VendorBillVersion[]
  vendorBillLines    VendorBillLine[]
  paymentApprovals PaymentApproval[]
  payments Payment[]
  paymentReversals PaymentReversal[]
  vendorAdvances VendorAdvance[]
}

// Phase 2 Task 4 — the per-project event stream counter. Exactly one row per project
// (created inside the project-creation transaction; backfilled for legacy projects).
// `emit()` locks this row (SELECT … FOR UPDATE via an atomic increment) and assigns the
// gap-safe `streamPosition` INSIDE the owning mutation transaction, so two concurrent
// commits on one project can never collide or skip a position.
model ProjectEventStream {
  projectId    String  @id
  nextPosition BigInt  @default(0)
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Phase 2 Task 4 — the append-only domain-event store. Ordering is (projectId, streamPosition),
// NEVER occurredAt (display/audit only). The composite tenant FK (organizationId, projectId) ->
// Project(orgId, id), the attribution truth-table CHECK, and the BEFORE UPDATE OR DELETE
// append-only trigger are all added in raw SQL by 20261015000000_phase2_event_envelope
// (Prisma cannot express them). See packages/shared/src/platform/events.ts for the envelope.
model DomainEvent {
  eventId         String   @id @default(uuid())
  eventType       String
  payloadVersion  Int      @default(1)
  organizationId  String
  projectId       String
  streamPosition  BigInt
  siteId          String?
  actorId         String?
  actorKind       String // 'human' | 'system'
  systemActor     String? // NON-NULL iff actorKind='system' (a named constant system actor)
  entityType      String
  entityId        String
  occurredAt      DateTime @default(now()) // DISPLAY/AUDIT ONLY — never an ordering key
  correlationId   String?
  causedByEventId String?
  payload         Json?
  // Phase 2 fix-forward PR B — immutable dispatch metadata recorded at commit time: what external
  // consequences (socket invalidate / push body+roles) the command requested. NOT a projection
  // result and NEVER mutated after insert. NULL = a pre-intent legacy event (the scanner treats it
  // as an external no-op; it never invents a historical push). PR C supplies the final per-command
  // catalog; PR B persists a compatibility intent (effectKey 'compat.task6').
  dispatchIntent  Json?
  // Composite tenant FK → Project(orgId, id): a forged organizationId (not the project's own
  // org) is rejected by the DB. RESTRICT — an append-only event outlives soft-deletes.
  tenant          Project  @relation(fields: [organizationId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([projectId, streamPosition])
  // Candidate key the OutboxDelivery composite FK references (PR B) — a delivery's copied
  // (projectId, streamPosition) can no longer disagree with its event's real coordinates.
  @@unique([eventId, projectId, streamPosition])
  @@index([projectId, streamPosition])
  @@index([eventType])
  deliveries      OutboxDelivery[]
}

// Phase 2 Task 6 — the per-consumer transactional outbox. For each DomainEvent, one
// OutboxDelivery row per registered consumer is written IN THE SAME mutation transaction, so a
// crash can never leave an event with no durable delivery work. A lease-based relay claims
// pending rows (a SHORT lease transaction — never a lock held across dispatch), dispatches to the
// consumer, and moves the row pending→leased→succeeded, or on a retryable failure clears the
// lease + backs off (attempts++, nextAttemptAt) back to pending, or on exhaustion → dead. There
// is NO ambiguous 'failed'. Contract: at-least-once delivery, effectively-once DB effects.
model OutboxDelivery {
  id             String      @id @default(uuid())
  // PR B — the composite FK binds the copied (projectId, streamPosition) to the event's REAL
  // coordinates, so a forged/mismatched delivery coordinate is rejected by PostgreSQL. Replaces
  // the Task-6 event-only FK. Cascade delete only ever fires for a disposable TRUNCATE reset.
  event          DomainEvent @relation(fields: [eventId, projectId, streamPosition], references: [eventId, projectId, streamPosition], onDelete: Cascade, onUpdate: Cascade)
  eventId        String
  projectId      String
  consumer       String
  consumerKind   String // 'ordered' | 'unordered'
  // PR B — every registered consumer gets a row for every event: 'dispatch' invokes the consumer,
  // 'noop' records the event was deliberately irrelevant (so an ordered cursor never waits behind
  // a stream position for which no row exists). Closed set; no inferred representation.
  deliveryAction String    @default("dispatch") // 'dispatch' | 'noop'
  streamPosition BigInt // copied from the event; ordered consumers checkpoint on it
  status         String    @default("pending") // 'pending' | 'leased' | 'succeeded' | 'dead'
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  lastError      String?
  payload        Json? // consumer-specific dispatch data (e.g. Web Push {body, roles})
  // Phase 6 task 4a — the entity a push delivery is ABOUT (the emitting module's entityId,
  // copied at materialization; backfilled from DomainEvent.entityId for legacy undelivered
  // rows). Platform-owned: the domain that learns a queued announcement went stale (e.g. a
  // decision withdrawn before its `decision.published` push left) cancels by subject through
  // the narrow platform operation — decisions never reaches into the relay, and the relay
  // never reads a decisions table.
  subject        String?
  // Phase 6 task 4a — the cancellation MARK ('cancelled and recorded, never deleted'). Set by
  // `cancelQueuedPushBySubject` inside the cancelling domain transaction; a still-pending row
  // is neutralized in place (status 'succeeded' + action 'noop', payload preserved for audit),
  // while a row already LEASED keeps its status and the sender's final pre-send re-check of
  // its OWN row drops the send and records the drop the same way. NOT a new status value —
  // the status CHECK is a deliberately closed set.
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // PR B — a restrictive composite FK to the durable consumer catalog: a delivery's
  // (consumer, consumerKind) must name a declared catalog contract, and a catalog row that still
  // has deliveries cannot be deleted (Restrict). Deactivation stops new obligations, never deletes.
  catalog        OutboxConsumerCatalog @relation(fields: [consumer, consumerKind], references: [consumer, consumerKind], onDelete: Restrict, onUpdate: Cascade)

  @@unique([eventId, consumer]) // exactly one delivery row per (event, consumer)
  @@index([consumer, status, nextAttemptAt]) // the relay's claim scan
  @@index([consumer, projectId, streamPosition]) // an ordered consumer's per-project stream
  @@index([consumer, subject]) // cancel-by-subject (Phase 6 task 4a)
}

// Phase 2 fix-forward PR B — the DURABLE consumer catalog. The relational pair
// (active OutboxConsumerCatalog row × DomainEvent row) is the obligation: exactly one
// OutboxDelivery must exist for it. This survives a process crash / rolling deploy without mutating
// the append-only DomainEvent — the scanner derives missing deliveries from this catalog. A changed
// kind/effect/version is a startup error requiring an explicit migration (never a silent reinterpret).
model OutboxConsumerCatalog {
  consumer       String   @id
  consumerKind   String // 'ordered' | 'unordered'
  consumerEffect String // 'db' | 'external'
  catalogVersion Int // the consumer CONTRACT version, not an app release
  active         Boolean  @default(true)
  registeredAt   DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deliveries     OutboxDelivery[]

  @@unique([consumer, consumerKind]) // the composite the OutboxDelivery FK references
}

// Phase 2 fix-forward PR B — a durable audit row for every operator dead-letter action
// (retry/redrive). Written IN THE SAME transaction as the action it records. Never stores event
// payloads or secrets.
model OutboxOperatorAction {
  id               String   @id @default(uuid())
  action           String // e.g. 'retry'
  deliveryId       String?
  consumer         String?
  projectId        String?
  eventId          String?
  operatorIdentity String
  reason           String
  priorError       String?
  at               DateTime @default(now())

  @@index([at])
}

// Phase 2 fix-forward PR B — declared now, sealed in PR C. A singleton row (CHECK key='singleton')
// records the external-effect coverage version that outbox-mode startup must match. PR B only
// declares the table; the audited seal transaction and the null-intent rejection trigger land in PR C.
model OutboxCutoverState {
  key             String   @id // singleton — CHECK (key = 'singleton')
  coverageVersion String
  sealedAt        DateTime @default(now())
  sealedBy        String
  reason          String
  updatedAt       DateTime @updatedAt
}

// Phase 2 Task 6 — a database consumer records one ProcessedEvent per (consumer, eventId) IN THE
// SAME transaction as its side effect (effectively-once). A duplicate dispatch finds the row and
// skips re-applying. External consumers (socket/push) are at-least-once and do not use this.
model ProcessedEvent {
  id          String   @id @default(uuid())
  consumer    String
  eventId     String
  processedAt DateTime @default(now())

  @@unique([consumer, eventId])
}

// Phase 2 Task 6 — an ordered (per-project) consumer advances this cursor CONTIGUOUSLY: it may
// not apply streamPosition N+1 before N. A slow/failed earlier position holds the cursor; a
// `dead` earlier position sets status='blocked' and the projection is visibly degraded until an
// operator resolves it — never a silent skip. `appliedPosition` NULL = nothing applied yet (next
// expected = 0); otherwise the next expected position is appliedPosition + 1.
model ProjectionCursor {
  id              String   @id @default(uuid())
  consumer        String
  projectId       String
  appliedPosition BigInt? // NULL = none applied yet
  status          String   @default("live") // 'live' | 'blocked'
  updatedAt       DateTime @updatedAt

  @@unique([consumer, projectId])
}

// Phase 2 Task 9 — a projection GENERATION: the rebuildable read-model instance a projection
// consumer serves + advances. Each (consumer, projectId) has a monotone series of generations;
// exactly ONE is 'active' at a time (a raw-SQL PARTIAL unique index — Prisma cannot express WHERE
// — enforces `one active per (consumer, projectId)`, added in 20261101000000_phase2_projection_generations).
//
// The live relay applies each ordered `db` projection delivery into the ACTIVE generation,
// advancing `appliedPosition` CONTIGUOUSLY (position N+1 waits for N; a `dead` earlier position
// sets cursorStatus='blocked' — visible degradation, never a silent skip). An ONLINE REBUILD
// builds a NEW 'building' generation from a consistent canonical snapshot + event replay, then a
// final ACTIVATION BARRIER (per project: hold the ProjectEventStream lock, read the final position
// H, apply through H, then atomically activate the new generation with appliedPosition=H and retire
// the old one before releasing the lock) hands over with zero gap — every event allocated afterward
// is > H and targets the new generation, so nothing commits into the retired one.
//
// Dedup is per generation on `(consumer, generation, streamPosition)`: within one generation
// `appliedPosition` is the contiguous high-water mark, and a generation has a SINGLE writer at any
// instant (the rebuilder while 'building', the relay once 'active' — the barrier hands off in one
// transaction), so an event applied by both the relay and a rebuild replay is idempotent (the later
// apply sees position ≤ appliedPosition and skips). Projection ROWS carry this `generation`'s id, so
// a building generation is invisible to serving until it is activated and a retired one is dropped.
model ProjectionGeneration {
  id              String    @id @default(uuid())
  consumer        String
  projectId       String
  generation      Int // monotone per (consumer, projectId); the highest is the newest
  status          String    @default("building") // 'building' | 'active' | 'retired'
  appliedPosition BigInt? // contiguous checkpoint INTO THIS generation (NULL = none applied yet)
  cursorStatus    String    @default("live") // 'live' | 'blocked' (a dead earlier position blocks)
  activatedAt     DateTime? // when this generation became 'active' (the barrier commit)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([consumer, projectId, generation])
  @@index([consumer, projectId, status])
}

// Phase 2 Task 9 — the DECISIONS read-model projection (the first module's rebuildable read path).
// One row per (generation, decision): the decisions module's `decisions.inbox` projection consumer
// refreshes it from the canonical Decision on every decision.* event, storing the SAME serialized
// DecisionDto the live snapshot produces (via decision-serialize.ts) plus the columns the query
// filters on. Generation-scoped: `generationId` names the ProjectionGeneration the row belongs to
// (a plain column, not an FK — the generation lifecycle is managed by the rebuilder + the consumer's
// dropGeneration hook, mirroring ProcessedEvent/ProjectionCursor), so a building generation is
// invisible to serving until activated and a retired one is dropped wholesale. The read query serves
// the ACTIVE generation's rows and applies the per-viewer authz filter at query time (a projection is
// never an RBAC bypass) — `status`/`publishedAt`/`authorId` are duplicated out of `dto` as the filter
// keys, and `dto` is the pre-serialized DecisionDto.
model DecisionProjection {
  id           String    @id @default(uuid())
  generationId String
  projectId    String
  decisionId   String
  status       String // 'pending' | 'approved' | 'change' — the readiness map + the pending filter
  publishedAt  DateTime? // NULL = a private DRAFT (author-only visibility)
  authorId     String? // the draft author (author-private visibility)
  dto          Json // the serialized DecisionDto (options + open changeRequest inlined), unfiltered
  updatedAt    DateTime  @updatedAt

  @@unique([generationId, decisionId])
  @@index([generationId, projectId])
}

// Phase 2 Task 10 — the DAILY-LOG read-model projection (the daily-log module's rebuildable read
// path). Unlike DecisionProjection (one row per decision), the daily-log slice is a per-PROJECT
// composite — the latest log core (crew + its own materials) plus every project material — so a
// generation holds exactly ONE row per project, keyed (generationId, projectId), storing the whole
// serialized slice `computeDailyLogSlice` produces. The `daily-log.inbox` projection consumer
// refreshes it from canonical state on every dailylog.*/material.* event. Generation-scoped:
// `generationId` names the ProjectionGeneration the row belongs to (a plain column, not an FK — the
// lifecycle is managed by the rebuilder + the consumer's dropGeneration hook). The slice carries NO
// per-viewer visibility (every project viewer sees the same daily-log), so the read query serves the
// ACTIVE generation's row with no query-time filter.
model DailyLogProjection {
  id           String   @id @default(uuid())
  generationId String
  projectId    String
  dto          Json // the serialized DailyLogSlice: { dailyLog: DailyLogCore | null, materials: SiteMaterial[] }
  updatedAt    DateTime @updatedAt

  @@unique([generationId, projectId])
}

// Phase 2 Task 10 — the DRAWINGS read-model projection (the drawings module's rebuildable read path).
// Like DailyLogProjection (one row per project, not per entity), the drawings register is a per-PROJECT
// composite — every drawing with its revision history + governing-revision distribution facts — so a
// generation holds exactly ONE row per project, keyed (generationId, projectId), storing the whole
// serialized VIEWER-INDEPENDENT base `computeDrawingsBase` produces (drawings-serialize.ts). The
// `drawings.inbox` projection consumer refreshes it from canonical state on every drawing.* event. The
// per-viewer fields (draft-author visibility, the viewer's ack/recipient state) and each revision's
// short-lived signed `url` are baked at READ time — the base is neither per-viewer nor time-limited, so
// the stored row is safe to reuse across viewers and never holds an expiring token. Generation-scoped:
// `generationId` names the ProjectionGeneration the row belongs to (a plain column, not an FK — the
// lifecycle is managed by the rebuilder + the consumer's dropGeneration hook).
model DrawingsProjection {
  id           String   @id @default(uuid())
  generationId String
  projectId    String
  dto          Json // the serialized DrawingsBase (viewer-independent register; url + viewer fields baked at read)
  updatedAt    DateTime @updatedAt

  @@unique([generationId, projectId])
}

model InspectionsProjection {
  id           String   @id @default(uuid())
  generationId String
  projectId    String
  dto          Json // the serialized InspectionsBase (viewer-independent; role gating + signed evidence baked at read)
  updatedAt    DateTime @updatedAt

  @@unique([generationId, projectId])
}

// Phase 2 Task 10 (Module 4) — the activities module's rebuildable read model (`activities.schedule`).
// ONE row per (generation, project): the serialized ACTIVITY-OWNED base (activities + overrides + phases
// as stored facts). Derived readiness is NEVER stored here — it depends on foreign modules' state
// (decisions/inspections/drawings) whose events this projection does not consume, so a stored conclusion
// could go silently stale; it is baked FRESH at read time through those modules' query contracts.
model ActivitiesProjection {
  id           String   @id @default(uuid())
  generationId String
  projectId    String
  dto          Json // the serialized ActivitiesBase (activity-owned facts only; readiness baked at read)
  updatedAt    DateTime @updatedAt

  @@unique([generationId, projectId])
}

// Phase 3 Task 6 — the SIXTH rebuildable projection: per-project UI material-readiness (§A/§G).
// Recompute-only: a consumer re-derives the material verdict for every activity with a material
// requirement from CANONICAL facts (coverageFor + the §A truth) on each relevant event. It feeds
// UI/Inbox/Dashboard/forecast ONLY — command authority (activities.start) reads canonical coverage
// in-tx, never this projection. Storing a derived verdict produces NO domain event (§G).
model MaterialReadinessProjection {
  id           String   @id @default(uuid())
  generationId String
  projectId    String
  dto          Json // { readings: { [activityId]: { v, reason, coveredQty, requiredQty } } }, activityId-sorted
  updatedAt    DateTime @updatedAt

  @@unique([generationId, projectId])
}

// Phase 4 Task 4 — the SEVENTH rebuildable projection: per-project labour-readiness FORECAST (§A/§G).
// Recompute-only: a labour-owned consumer re-derives every labour-requirement-bearing activity's
// forecast verdict from the labour-owned requirement read-model (folded from the consumed
// `requirement.*` event payloads — never an Activities persistence read; Labour stays a LEAF) plus
// the §C facts. It feeds UI/Inbox/Dashboard ONLY — command authority (activities.start) reads
// EXECUTION coverage in-tx, never this projection. Storing a derived verdict produces NO domain
// event (§G).
model LabourReadinessProjection {
  id           String   @id @default(uuid())
  generationId String
  projectId    String
  dto          Json // { forecast: { [activityId]: { verdict, reason, coveringDate } } }, activityId-sorted
  updatedAt    DateTime @updatedAt

  @@unique([generationId, projectId])
}

// Phase 5 Task 7A — the EIGHTH rebuildable projection: the per-project CASH FORECAST (§J).
// Recompute-only: every refresh re-derives all seven buckets from canonical facts through the ONE
// shared `computeCashForecastDto`, so live == projection == rebuild by construction. Storing a
// derived money picture produces NO domain event (§G), and no command authority reads this row —
// §B's over-budget exception is raised from the LIVE fold inside the writer's own transaction.
//
// Unlike the six and seventh projections this one has TWO refresh paths, because commercial's
// manifest declares `producesEvents: []`: foreign facts (the PO lifecycle, acceptance) arrive as
// events and refresh through the ordered consumer, while commercial's own writes refresh
// write-through in their own transaction. Both call the same compute function, so neither path
// can produce a number the other would not.
model CashForecastProjection {
  id           String   @id @default(uuid())
  generationId String
  projectId    String
  dto          Json // CashForecastDto — { heads: CostHeadPositionDto[], totals }, worst-headroom-first
  updatedAt    DateTime @updatedAt

  @@unique([generationId, projectId])
}

// Phase 2 Task 10 (Module 3) correction — the INSPECTION-OWNED evidence link. Item-level photo evidence
// was formerly read off the Media table by the inspections serializer (a cross-module read the projection
// could not observe when a photo was uploaded/removed). Each row is an inspection-owned link from an
// inspection item to a media identity, maintained by the inspections participant inside the media
// create/remove transaction (which also appends an inspection event, so the projection refreshes). The
// legacy Media linkage columns are RETAINED for compatibility; this table is the serializer's source.
// Standalone (no Prisma relations, mirroring InspectionsProjection); the FK backstops live in the
// correction migration. Backfilled from existing linked Media rows.
model InspectionEvidence {
  id               String   @id @default(uuid())
  projectId        String
  inspectionId     String
  inspectionItemId String
  mediaId          String
  createdAt        DateTime @default(now())

  @@unique([inspectionItemId, mediaId]) // one link per (item, media)
  @@index([projectId])
  @@index([mediaId])
  @@index([inspectionId])
}

// Phase 2 Task 5 — the command-idempotency ledger. One receipt per (scope, actor, commandType,
// idempotencyKey): a retried/duplicated command (offline replay, network retry, double-tap)
// reserves→executes→commits its succeeded receipt in ONE transaction, so the effect happens
// exactly once and a replay returns the stored result. Ordering/collision is enforced by
// SCOPE-SPECIFIC PARTIAL unique indexes (raw SQL — Prisma cannot express WHERE): project-scoped
// rows key on (projectId, actorId, commandType, idempotencyKey), org-scoped rows on
// (organizationId, …), so an org index never constrains a project row. The scope truth-table
// CHECK, the status CHECK and the composite project-scoped tenant FK (organizationId, projectId)
// -> Project(orgId, id) are raw SQL too (20261016000000_phase2_command_ledger). The simple
// organizationId -> Org(id) FK below is Prisma-expressible and covers org-scoped rows.
model CommandExecution {
  id             String    @id @default(uuid())
  scopeKind      String // 'project' | 'org'
  organizationId String
  projectId      String? // NULL for org-scoped commands (the scope CHECK enforces this)
  actorId        String
  commandType    String
  idempotencyKey String
  requestHash    String
  status         String // 'reserved' | 'succeeded' | 'failed'
  resultRef      String? // the committed entity id (Decision.id, …), replayed to the same actor+scope
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  org Org @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Phase 3 Task 4 — stock ledger rows recording this execution as their source action (§C)
  stockTransactions StockTransaction[]

  // Tasks 4–5 integrity correction (F1) — the project-contained candidate key a
  // StockTransaction's (projectId, sourceCommandId) composite FK references, so a ledger row
  // can only cite a command execution IN ITS OWN PROJECT.
  @@unique([projectId, id])
  @@index([organizationId])
  @@index([projectId])
}

// A firm/consultant associated with a project — the client company, the main
// contractor, the structural/MEP consultants, etc. Distinct from Membership (which
// is a *person* with a login role); a company is an organisation + a contact.
//
// Phase 6 unit 6.1a (§A): this row is no longer only a directory entry — it is one of the
// two SOURCES that justify a party's association with a project, so it carries `partyId`
// and gains `orgId`. The org copy is itself bound to the project by `(orgId, projectId) ->
// Project(orgId, id)`: without that, a row could keep `projectId` on an org-A project, set
// its copied `orgId` to org B and point at an org-B party, and every other FK would pass.
model ProjectCompany {
  id           String   @id @default(cuid())
  projectId    String
  // The project's own org, DB-bound to it — never an independently settable copy.
  orgId        String
  // ONE foreign key to `Project`, composite and CASCADING. An earlier draft kept the original
  // single-column `projectId` FK (cascade) and ADDED this one as NoAction — but PostgreSQL
  // enforces both, so the stricter one won and deleting a project silently stopped working
  // wherever it held a directory row. Two keys to the same parent with different delete actions
  // is not a stronger seal, it is an incoherent one. The composite key subsumes the single
  // column, so the single column goes.
  project      Project  @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade, onUpdate: NoAction)
  // The canonical firm this directory entry represents (§A). Same-org composite FK, so a
  // cross-org party link is unrepresentable rather than merely refused.
  partyId      String
  party        ExternalParty @relation(fields: [orgId, partyId], references: [orgId, id], onDelete: NoAction, onUpdate: NoAction)
  name         String // firm / organisation name
  kind         String // client | contractor | architect | structural | mep | pmc | consultant | other
  contactName  String?
  contactEmail String?
  contactPhone String?
  notes        String?
  createdAt    DateTime @default(now())

  partySources ProjectPartyCompanySource[]

  @@index([projectId])
  @@index([orgId, partyId])
  // The candidate key `ProjectPartyCompanySource` binds through, so a source row proves its
  // origin is the source FOR THIS association rather than merely existing in the same org.
  @@unique([orgId, projectId, partyId, id])
  // §A: one party, one directory row per project. 6.1b's merge must resolve a same-project
  // collision explicitly instead of repointing into it and leaving two rows for one firm.
  @@unique([projectId, partyId])
}

// ─── Phase 6 unit 6.1a (§A) — one canonical external party ────────────────────────────────
//
// Suppliers, contractors and consultants exist three times today: `ProjectCompany` (a
// directory entry), `Vendor`/`ProjectVendor` (the commercial counterparty), and a
// prospective guest `Org`. This is the identity all three reconcile to.
//
// Owned by ORGS, not procurement, and the reason is dependency direction rather than
// convenience: the access path must never read procurement, so the canonical party sits at
// the orgs end of an edge that runs INTO orgs. Promoting `Vendor` instead would have forced
// `orgs.dependsOn += procurement` — the module deciding who may see anything reading the
// module that buys things.
model ExternalParty {
  id        String   @id @default(cuid())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  name      String
  createdAt DateTime @default(now())
  // NULLABLE, and only for rows the 6.1a backfill created. `ProjectCompany` carries no
  // creator column, so a party derived from one has no attributable author — and inventing
  // an actor would be worse than recording that none is known. Every party created by a
  // COMMAND carries its caller; a NULL here means "existed before parties did".
  createdBy User?    @relation("externalPartiesCreated", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById String?

  // §E — the stable link to a future tenant. The promotion COMMAND is deferred out of Phase
  // 6, which is exactly why the guard ships now: nothing here sets this column, so nothing
  // here would stop a later retry or repair moving a party from one tenant to another, and
  // historical guest work would resolve to the wrong one. Raw SQL adds the one-way trigger
  // (null -> org permitted; any change of a non-null value refused) and the partial unique on
  // non-null `(orgId, promotedOrgId)` — scoped to the OWNER org, because a supplier working
  // with two owner orgs legitimately has a local party in each.
  promotedOrgId String?
  // §E — the promotion target is a REAL tenant. Declared HERE and not only in the migration:
  // the schema is the source a future `prisma migrate dev` diffs against, so an FK that exists
  // only in SQL is an FK a later generated migration will quietly drop — re-opening the frozen
  // typo the one-way trigger can never let an operator correct.
  promotedOrg   Org?    @relation("externalPartyPromotedTo", fields: [promotedOrgId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  vendors        Vendor[]
  projectCompanies ProjectCompany[]
  projectVendors ProjectVendor[]
  projectParties ProjectParty[]

  @@index([orgId])
  // Every party reference in this schema is a same-org composite FK through this key.
  @@unique([orgId, id])
}

// The canonical per-project association — the ONLY table the collaborator resolver reads.
//
// `ProjectCompany` alone would leave a materials supplier (which exists only as `Vendor` +
// `ProjectVendor`) unreachable, but reading `ProjectVendor` to fix that would put a
// procurement-owned table inside the authority predicate — the same inversion §A rejects.
// So both mirror into this orgs-owned row and the resolver never leaves orgs.
//
// It carries the org seal on BOTH sides. It is the only thing the resolver reads, so a row
// pairing an org-A project with an org-B party would make that party associated with that
// project no matter how well every other table is sealed.
model ProjectParty {
  id        String   @id @default(cuid())
  orgId     String
  projectId String
  partyId   String
  project   Project  @relation("projectPartyProject", fields: [orgId, projectId], references: [orgId, id], onDelete: NoAction, onUpdate: NoAction)
  party     ExternalParty @relation(fields: [orgId, partyId], references: [orgId, id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())

  companySources ProjectPartyCompanySource[]
  vendorSources  ProjectPartyVendorSource[]

  // One association per (project, party) — so a merge cannot leave two rows on one project
  // with independently editable identities.
  @@unique([projectId, partyId])
  @@index([orgId, partyId])
}

// ─── Which SOURCE justifies an association ────────────────────────────────────────────────
//
// One party can hold both a `ProjectCompany` and a `ProjectVendor` on the same project, so
// removing one source must not drop an association the other still supports — and orgs
// cannot read procurement to find out.
//
// An earlier design did this with a single `(projectId, partyId, source)` triple and a
// discriminator. That shape has no source-specific key, so no ordinary foreign key can bind
// a `source='vendor'` row to the `ProjectVendor` justifying it, and every possible drift had
// to be caught by a hand-written guard. Normalised into one table per origin, a source row
// outliving its origin is UNREPRESENTABLE instead of guarded against.
//
// The FK carries the project and the party, not just the origin id: an FK to the origin
// alone would say only "some binding exists in this org", so a row justifying
// ProjectParty(project B, party P) could point at an origin on project A and still pass.
model ProjectPartyCompanySource {
  id             String   @id @default(cuid())
  orgId          String
  projectId      String
  partyId        String
  projectCompanyId String
  // Restrict, NOT cascade: cascading let a direct delete of the association take its own
  // justification with it, after which the deferred check counted zero sources and returned
  // happy — leaving a directory row whose firm the resolver cannot see. The release path already
  // deletes the association only once both counts are zero, so the legitimate order still works.
  projectParty   ProjectParty   @relation(fields: [projectId, partyId], references: [projectId, partyId], onDelete: Restrict)
  origin         ProjectCompany @relation(fields: [orgId, projectId, partyId, projectCompanyId], references: [orgId, projectId, partyId, id], onDelete: Cascade)

  @@unique([projectCompanyId])
  @@index([projectId, partyId])
}

model ProjectPartyVendorSource {
  id              String   @id @default(cuid())
  orgId           String
  projectId       String
  partyId         String
  projectVendorId String
  // Restrict, matching the company source: cascading let a direct delete of the association take
  // its own justification with it, after which the deferred check counted zero and returned happy.
  projectParty    ProjectParty  @relation(fields: [projectId, partyId], references: [projectId, partyId], onDelete: Restrict)
  origin          ProjectVendor @relation(fields: [orgId, projectId, partyId, projectVendorId], references: [orgId, projectId, partyId, id], onDelete: Cascade)

  @@unique([projectVendorId])
  @@index([projectId, partyId])
}

// An Org/Account (an architecture practice, e.g. "Vitan Architecture") — owns
// projects and the people who administer them. Multi-tenant foundation.
model Org {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  createdAt DateTime        @default(now())
  projects  Project[]
  members   OrgMembership[]
  modules   TemplateModule[]
  templates ProjectTemplate[]
  commandExecutions CommandExecution[]
  vendors           Vendor[]
  // Phase 6 unit 6.1a (§A) — the canonical external firms this org collaborates with.
  externalParties   ExternalParty[]
  promotedParties   ExternalParty[] @relation("externalPartyPromotedTo")
}

// Templates Slice 3 (docs/TEMPLATES.md): a named PRESET — an ordered selection of modules
// ("G+2 Residence" = Ground Floor + Second Floor + Terrace + Standard QA). Picking a preset
// at Create Project expands its items through the same module instantiation as an
// à-la-carte pick. Editing a preset never touches already-created projects.
model ProjectTemplate {
  id          String    @id @default(cuid())
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String
  name        String
  version     Int       @default(1) // informational in v1 (design decision #5)
  description String    @default("")
  items       Json // [{ moduleId, count?, underZone? }] — validated against org modules on save
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId])
}

// Templates Slice 2 (docs/TEMPLATES.md): a reusable menu item — a slice of project
// STRUCTURE (a location subtree, phases + planned activities, checklist definitions)
// scoped to one space/area/discipline, composed in any mix at Create Project. Org-owned:
// templates are "methods" and live on the Org; instances always belong to a project
// (see TENANCY.md). Content is a Zod-validated JSON payload with payload-internal node
// keys — instantiation mints fresh ids, so a module is fully self-contained.
model TemplateModule {
  id          String    @id @default(cuid())
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String
  name        String
  category    String // space | zone | element | discipline | schedule
  // where the module's ROOT nodes graft: null = top level (roots are zones / project-wide),
  // 'zone' = roots are rooms (need a zone), 'room' = roots are elements (need a room)
  anchorKind  String?
  version     Int       @default(1) // informational in v1 (design decision #5)
  description String    @default("")
  payload     Json // { nodes?, phases?, activities?, inspections? } — see contracts.modulePayloadSchema
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId, category])
}

// Who can administer an org: owner/admin create projects + manage teams; member
// is a plain participant. Distinct from a project role (pmc/client/…).
model OrgMembership {
  id        String   @id @default(cuid())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      String // owner | admin | member
  createdAt DateTime @default(now())

  @@unique([orgId, userId])
  @@index([userId])
}

// A user's access to a specific project, with the role they hold there. A user
// can have memberships on several projects (different roles on each). This is the
// grant the app scopes tokens to; the legacy User.projectId/role is the default.
model Membership {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      String // pmc | client | engineer | contractor | consultant
  // For a `consultant` member: the discipline they cover (architect | mep | lighting | …).
  // A label, not a permission — every consultant shares the same read-mostly role.
  discipline String?
  status    String   @default("active") // invited | active | removed
  createdAt DateTime @default(now())

  /// Phase 5 Task 6A (§I) — this member's payment-approval ceiling, applied to a claim's
  /// CUMULATIVE approved total rather than to one authorisation: a per-row check lets a ₹50 holder
  /// authorise ₹100 as two ₹50 rows, each within limit and the ceiling defeated. NULL is
  /// "unlimited", which is what every existing membership is; zero is a real ceiling that refuses
  /// everything, because "may not approve" is a thing a practice may want to say about a role.
  approvalLimit Decimal? @db.Decimal(18, 2)

  // drawing distributions frozen against this membership (Phase 1 Task 3)
  drawingRecipients DrawingRecipient[]
  // corrective/reinspection work assigned to this membership (Phase 1 Task 4)
  inspectionAssignments Inspection[]
  // completion claims recorded against this membership (Phase 1 Task 5)
  completionClaims Activity[] @relation("CompletionClaims")
  // decisions this member withdrew (Phase 6 task 4a) — attribution is FK-backed, never free-text
  decisionWithdrawals Decision[] @relation("DecisionWithdrawals")
  // current decision-holder designations (Phase 6 task 4b expansion)
  decisionsHeld Decision[] @relation("DecisionDeciders")

  @@unique([projectId, userId])
  // candidate key for Decision's same-project holder FK
  @@unique([projectId, id])
  @@index([userId])
  responsibleFor ActivityRequirement[]
}

// A browser Web Push subscription (Phase 8). Endpoint is unique per device;
// notifications for a project fan out to all its subscriptions. When no VAPID
// keys are configured the send path is a no-op (dev stub).
model PushSubscription {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  role      String?
  createdAt DateTime @default(now())
}

// An uploaded site photo (geo + timestamp, zoomable on the client). Phase
// 7c-media. Storage is provider-agnostic: with S3/R2 configured the bytes live
// in the bucket and `url` points at them; with no provider the bytes are kept
// in `data` (dev stub) and served from GET /media/:id. `decisionId`/`dailyLogId`
// are loose links to what the photo documents.
model Media {
  id         String   @id @default(cuid())
  // Phase 4 Task 3 correction (F2) — the musters citing this photo as presence evidence
  labourAttendance LabourAttendance[] @relation("labourAttendanceEvidence")
  activityWorkOutputEvidence ActivityWorkOutput[]
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  kind       String // progress | inspection | decision | attendance | material
  mime       String
  data       Bytes? // dev stub: bytes in the DB; null once stored in S3/R2
  url        String? // set in S3/R2 mode; null for the dev stub
  storageKey String?
  sizeBytes  Int      @default(0)
  geoLat     Float?
  geoLng     Float?
  takenAt    String? // display timestamp, e.g. "03 Jul 2026 · 9:12 AM"
  uploadedBy String
  // Project-owned references: composite (projectId, x) FKs — PostgreSQL rejects a
  // link to another project's record even on a direct write. NoAction because the
  // owning projectId is non-null (SET NULL would null it too); deletion behavior
  // is service-owned. Phase 0 Task 5.
  decision   Decision? @relation(fields: [projectId, decisionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  decisionId String?
  dailyLog   DailyLog? @relation(fields: [projectId, dailyLogId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  dailyLogId String?
  // The place this photo shows the reality of (zone/room/object). The location tree is
  // the shared spatial spine: a photo here + a drawing on the same node = intent vs reality
  // for one object. SET NULL so removing a node never deletes the photo. Location spine.
  node       ProjectNode? @relation(fields: [projectId, nodeId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  nodeId     String?
  // The evidence containment CHAIN (Phase 1 Task 4): (projectId, inspectionId) proves
  // the inspection belongs to this project; (inspectionId, inspectionItemId) proves the
  // item belongs to THAT inspection. Raw SQL cannot pair inspection A with an item of
  // inspection B, and the CHECK "Media_item_requires_inspection" (raw SQL — Prisma can't
  // express CHECKs) closes the MATCH SIMPLE escape: a non-null item with a NULL
  // inspection would bypass the composite FK entirely, so it is forbidden outright.
  inspection       Inspection?     @relation(fields: [projectId, inspectionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  inspectionId     String?
  inspectionItem   InspectionItem? @relation(fields: [inspectionId, inspectionItemId], references: [inspectionId, id], onDelete: NoAction, onUpdate: NoAction)
  inspectionItemId String?
  // PROJECT-SCOPED idempotency for offline replays — the same (projectId, clientKey)
  // is the same photo, uploaded exactly once. Never a global unique.
  clientKey  String?
  createdAt  DateTime @default(now())
  // overrides citing this photo as supporting evidence (Phase 1 Task 6)
  gateOverrides GateOverride[]
  // stock quality decisions citing this photo (Phase 3 Task 4) — the ledger is immutable, so
  // media backing a stock transaction is not deletable (InventoryParticipant refuses)
  stockEvidence StockTransaction[]

  @@unique([projectId, id]) // referenced identity (Task 6 override evidence)
  @@unique([projectId, clientKey])
  @@index([projectId, kind])
  @@index([nodeId])
  @@index([inspectionId])
  measurements Measurement[]
}

// A controlled drawing in the project's register (the source of truth the team
// builds from). Identified by its number within the project; each issue is a
// DrawingRevision, the latest non-superseded one being "current". Files are held
// by StorageService (S3/R2 or the DB dev stub), same as Media. Slice 1.
model Drawing {
  id         String            @id @default(cuid())
  project    Project           @relation(fields: [projectId], references: [id])
  projectId  String
  number     String // e.g. "A-201"
  title      String
  discipline String // architectural | structural | mep | other
  zone       String?
  // Project-owned references (composite FKs, same rationale as Media). The activity
  // link is severed by ActivitiesService.remove BEFORE the activity row is deleted.
  activity   Activity? @relation(fields: [projectId, activityId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  activityId String? // the work this drawing governs (Slice 2 linkage)
  decision   Decision? @relation(fields: [projectId, decisionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  decisionId String?
  // The place this drawing governs (zone/room/object). Filed at its natural level — a
  // floor plan on the zone, a joinery detail on the element — and inherited DOWN: a room
  // shows every drawing filed on it or any ancestor. A node delete keeps the drawing
  // (it becomes unfiled) — NodesService unlinks in-transaction; the composite FK makes
  // a cross-project filing impossible even on a direct write. Location spine.
  node       ProjectNode?      @relation(fields: [projectId, nodeId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  nodeId     String?
  // Draft → Publish lifecycle (mirrors Decision). While `publishedAt` is null the drawing is
  // a private DRAFT: the snapshot delivers it only to its author, it never notifies the build
  // team, and it's absent from the register / Site Map. Publishing issues it. Both nullable/
  // additive; existing rows backfilled to createdAt so nothing becomes an invisible draft.
  publishedAt DateTime?
  authorId   String?
  createdAt  DateTime          @default(now())
  revisions  DrawingRevision[]

  @@unique([projectId, number])
  @@unique([projectId, id]) // composite identity — tenant-safe containment target (Phase 1 Task 3)
  @@index([projectId])
  @@index([nodeId])
}

// One issued revision of a drawing (Rev A, B, C…). Supersession is SCOPED
// (Phase 1 Task 3): a for_construction issue supersedes only the prior
// for_construction set; a for_review issue supersedes NOTHING — it coexists
// as a review copy and can never govern the field.
model DrawingRevision {
  id         String   @id @default(cuid())
  // Containment: the revision's project IS its parent drawing's project — the
  // composite FK makes a cross-project revision row impossible even on a direct write.
  drawing    Drawing  @relation(fields: [projectId, drawingId], references: [projectId, id], onDelete: Cascade)
  drawingId  String
  projectId  String
  rev        String // "A" | "B" | "C" …
  // for_review | for_construction | superseded. AT MOST ONE live for_construction
  // revision may exist per drawing — enforced by the partial unique index
  // "DrawingRevision_one_construction_per_drawing" ON ("drawingId") WHERE
  // status = 'for_construction' (raw SQL in 20260925000000_phase1_drawing_governing;
  // Prisma cannot express partial uniques). The service serializes issues/publishes
  // on the parent Drawing row (SELECT … FOR UPDATE); this index is the DB backstop.
  status     String
  mime       String
  data       Bytes? // dev stub: bytes in the DB; null once stored in S3/R2
  url        String? // set in S3/R2 mode; null for the dev stub
  storageKey String?
  sizeBytes  Int      @default(0)
  note       String   @default("")
  issuedBy   String
  issuedAt   String // display timestamp, e.g. "08 Jul 2026"
  // Stamped when the recipient snapshot executed — EVEN when it froze an empty set.
  // null = the revision predates recipient snapshots (legacy); the migration never
  // invents snapshots, and Task 6's readiness truth table treats the two differently.
  recipientsFrozenAt DateTime?
  createdAt  DateTime @default(now())
  acks       DrawingAck[]
  recipients DrawingRecipient[]

  @@unique([projectId, id]) // composite identity — tenant-safe reference target (Task 3)
  @@unique([drawingId, rev]) // one Rev B per drawing — a duplicate label is a 409
  @@index([drawingId])
}

// WHO a revision was issued to — frozen at issue time (Phase 1 Task 3). The rows
// snapshot the project's ACTIVE engineer/contractor members at the moment of issue;
// membership churn never rewrites them (readiness derives recipients ∩ currently-
// active members in Task 6). Both FKs are composite so PostgreSQL itself refuses a
// recipient naming another project's revision or a user with no membership here.
// Memberships are soft-removed (status='removed'), never deleted, so NO ACTION is safe.
model DrawingRecipient {
  id          String          @id @default(cuid())
  projectId   String
  revision    DrawingRevision @relation(fields: [projectId, revisionId], references: [projectId, id], onDelete: Cascade)
  revisionId  String
  membership  Membership      @relation(fields: [projectId, userId], references: [projectId, userId], onDelete: NoAction, onUpdate: NoAction)
  userId      String
  roleAtIssue String // engineer | contractor — the role held when the set was frozen
  createdAt   DateTime        @default(now())

  @@unique([revisionId, userId])
  @@index([projectId, userId])
}

// A build-acknowledgement: a contractor / engineer confirming they are building
// to a specific revision ("building to Rev C"). Per-revision, so a superseding
// issue starts a fresh round of acks — the PMC can see who is on the current set.
model DrawingAck {
  id         String          @id @default(cuid())
  revision   DrawingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  revisionId String
  userId     String
  userName   String
  role       String
  at         DateTime        @default(now())

  @@unique([revisionId, userId])
  @@index([revisionId])
}

// A real account: PMC / client / contractor sign in with email + password;
// site engineers are provisioned on first successful phone OTP. Passwordless
// dev auth (the "Viewing as" persona switch) is separate and gated by
// ALLOW_DEV_AUTH. Phase 7c-auth.
model User {
  billVerificationsVerified BillVerification[] @relation("billVerificationsVerified")
  billCertificatesCertified BillCertificate[]  @relation("billCertificatesCertified")
  sodExceptionsActor        SodException[]     @relation("sodExceptionsActor")
  sodExceptionsApprover     SodException[]     @relation("sodExceptionsApprover")
  sodGrantsActor            SodGrant[]         @relation("sodGrantsActor")
  sodGrantsApprover         SodGrant[]         @relation("sodGrantsApprover")
  billDeductionsRecorded    BillDeduction[]    @relation("billDeductionsRecorded")
  billDeductionReleases     BillDeductionRelease[] @relation("billDeductionReleases")
  id                String    @id @default(cuid())
  project           Project   @relation(fields: [projectId], references: [id])
  projectId         String
  role              String // pmc | client | engineer | contractor
  name              String
  email             String?   @unique
  phone             String?   @unique
  passwordHash      String?
  emailVerifiedAt   DateTime?
  credentialVersion Int       @default(0)
  createdAt         DateTime  @default(now())

  orgMemberships OrgMembership[]
  memberships    Membership[]
  passwordChallenges PasswordCredentialChallenge[]
  securityEvents     SecurityAuditEvent[]          @relation("SecurityEventTarget")
  securityActorEvents SecurityAuditEvent[]         @relation("SecurityEventActor")
  requirementRootsCreated ActivityRequirementRoot[]  @relation("requirementRootsCreated")
  requirementsCreated     ActivityRequirement[]      @relation("requirementsCreated")
  approvalsRecorded       DecisionApprovalRevision[] @relation("approvalRevisionsApproved")
  vendorsCreated          Vendor[]                   @relation("vendorsCreated")
  externalPartiesCreated  ExternalParty[]            @relation("externalPartiesCreated")
  vendorsBound            ProjectVendor[]            @relation("vendorsBound")
  requisitionsCreated     Requisition[]              @relation("requisitionsCreated")
  rfqsIssued              Rfq[]                      @relation("rfqsIssued")
  quotesRecorded          VendorQuote[]              @relation("quotesRecorded")
  comparisonsCreated      QuoteComparison[]          @relation("comparisonsCreated")
  purchaseOrdersCreated   PurchaseOrder[]            @relation("purchaseOrdersCreated")
  poVersionsCreated       PurchaseOrderVersion[]     @relation("poVersionsCreated")
  commitmentsCreated      DeliveryCommitment[]       @relation("commitmentsCreated")
  promisesRecorded        DeliveryPromise[]          @relation("promisesRecorded")
  stockLotsReceived         StockLot[]         @relation("stockLotsReceived")
  stockTransactionsRecorded StockTransaction[] @relation("stockTransactionsRecorded")
  materialIssuesIssued      MaterialIssue[]      @relation("materialIssuesIssued")
  mismatchesResolved        MismatchResolution[] @relation("mismatchesResolved")
  substitutionsApproved     ApprovedSubstitution[] @relation("substitutionsApproved")
  substitutionsRevoked      ApprovedSubstitution[] @relation("substitutionsRevoked")
  // Phase 4 Task 1 — trusted-workforce identity attribution (plan §H)
  labourTradesCreated       LabourTrade[]  @relation("labourTradesCreated")
  labourSkillsCreated       LabourSkill[]  @relation("labourSkillsCreated")
  workersOnboarded          Worker[]       @relation("workersOnboarded")
  workersRevoked            Worker[]       @relation("workersRevoked")
  crewsFormed               Crew[]         @relation("crewsFormed")
  crewsRevoked              Crew[]         @relation("crewsRevoked")
  crewMembersAdded          CrewMembership[] @relation("crewMembersAdded")
  crewMembersRemoved        CrewMembership[] @relation("crewMembersRemoved")
  // Phase 4 Task 3 — attribution on the §C time-capacity facts
  allocationsMade            WorkerAllocation[] @relation("allocationsMade")
  allocationsReleased        WorkerAllocation[] @relation("allocationsReleased")
  attendanceRecorded         LabourAttendance[] @relation("attendanceRecorded")
  attendanceRevoked          LabourAttendance[] @relation("attendanceRevoked")
  labourWorkRecorded         LabourWorkFact[]   @relation("labourWorkRecorded")
  labourMismatchesRecorded   LabourMismatch[]   @relation("labourMismatchesRecorded")
  labourMismatchesResolved   LabourMismatchResolution[] @relation("labourMismatchesResolved")
  activityOutputsRecorded    ActivityWorkOutput[] @relation("activityOutputsRecorded")
  skillSubstitutionsApproved ApprovedSkillSubstitution[] @relation("skillSubstitutionsApproved")
  skillSubstitutionsRevoked  ApprovedSkillSubstitution[] @relation("skillSubstitutionsRevoked")
  // Phase 5 Task 1 (§C/§L)
  costHeadsDefined           CostHead[]              @relation("costHeadsDefined")
  attributionsCreated        CommitmentAttribution[] @relation("attributionsCreated")
  attributionsSuperseded     CommitmentAttribution[] @relation("attributionsSuperseded")
  budgetLinesAuthored        BudgetLine[]            @relation("budgetLinesAuthored")
  budgetLinesSuperseded      BudgetLine[]            @relation("budgetLinesSuperseded")
  budgetExceptionsRaised     BudgetException[]       @relation("budgetExceptionsRaised")
  measurementsTaken Measurement[] @relation("measurementsTaken")
  vendorBillsCreated          VendorBill[]        @relation("vendorBillsCreated")
  vendorBillVersionsCreated   VendorBillVersion[] @relation("vendorBillVersionsCreated")
  vendorBillVersionsSuperseded VendorBillVersion[] @relation("vendorBillVersionsSuperseded")
  paymentApprovalsApproved PaymentApproval[] @relation("paymentApprovalsApproved")
  paymentsRecorded Payment[] @relation("paymentsRecorded")
  paymentsReversed PaymentReversal[] @relation("paymentsReversed")
  advancesPaid VendorAdvance[] @relation("advancesPaid")
}

// Durable, purpose-bound proof used only to establish or reset a password. It
// never represents an application session and stores no reusable secret.
model PasswordCredentialChallenge {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose             String
  otpHash             String
  attempts            Int       @default(0)
  expiresAt           DateTime
  verifiedAt          DateTime?
  setupTokenHash      String?   @unique
  setupTokenExpiresAt DateTime?
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
}

// Identity-level security trail. Password recovery is not a project event, so
// it must not be forced into the project operations AuditLog.
model SecurityAuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  action        String
  targetUserId  String
  targetUser    User     @relation("SecurityEventTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  actorUserId   String?
  actorUser     User?    @relation("SecurityEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorKind     String
  correlationId String
  payload       Json?
  createdAt     DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
}

// A worker's device identity (QR / tap-photo job card) — no account, no
// password. Each tap mints a short-lived scoped token recorded here for
// attribution. Phase 7c-auth.
model WorkerDevice {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  // Phase 4 Task 1 (§H) — the trusted-identity binding: a device attributes attendance to a
  // first-class same-project Worker. NULLABLE so anonymous QR/tap onboarding (no Worker yet)
  // still works byte-for-byte; a bound device carries the composite (projectId, workerId) FK,
  // so a device can NEVER reference a Worker in another project. Free-text name/trade below are
  // display-only and are NEVER readiness evidence (the FK identity is).
  worker    Worker?  @relation(fields: [projectId, workerId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  workerId  String?
  name      String?
  trade     String?
  token     String   @unique
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())

  // Phase 4 Task 3 — the musters this device evidenced (a same-project composite FK from the
  // attendance fact, so a device can never evidence presence in another project).
  attendance LabourAttendance[]

  @@unique([projectId, id])
}

// A node in a project's location tree: zone → room → element (the object). Decisions
// (and later activities / inspections / materials) attach to a node so they can be
// grouped, filtered and browsed by where they live in the building.
model ProjectNode {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  // Composite self-FK: a node can only hang under a parent in the SAME project —
  // PostgreSQL rejects a cross-project tree edge even on a direct write. Cascade
  // still removes the subtree when a parent goes.
  parent    ProjectNode?  @relation("NodeChildren", fields: [projectId, parentId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)
  parentId  String?
  name      String
  kind      String // zone | room | element
  order     Int      @default(0)
  // Draft → Publish lifecycle (mirrors Decision/Drawing). A node with a null `publishedAt` is a
  // private DRAFT: it's delivered only to its author and hidden from the team's Site Map and the
  // filing pickers — so no published item can ever be filed on a draft node (the invariant that
  // keeps the location spine safe). Publishing a node publishes its subtree + draft ancestors.
  publishedAt DateTime?
  authorId  String?
  createdAt DateTime @default(now())

  children    ProjectNode[]  @relation("NodeChildren")
  decisions   Decision[]
  media       Media[]
  drawings    Drawing[]
  activities  Activity[]
  inspections Inspection[]
  materials   SiteMaterial[]

  // composite identity for the (projectId, nodeId) FKs — see Media/Decision/…
  @@unique([projectId, id])
  @@index([projectId])
  @@index([parentId])
}

// ── Phase 3 Task 1 — pilot activation + the ActivityRequirement demand contract ─────────────

// Project-scoped capability activation (plan §D). A Phase-3 surface exists for a project ONLY
// when its capability row exists — non-pilot projects keep today's behavior byte-for-byte
// (routes 404, no Phase-3 events, stored gateMaterial semantics unchanged). Platform-owned.
model ProjectCapability {
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  capability  String // 'materials' (Stage 1)
  enabledAt   DateTime @default(now())
  enabledById String

  @@id([projectId, capability])
}

enum RequirementType {
  material
  labour
  equipment
  decision
  drawing
  inspection
}

// Phase 3 Task 1 correction — the requirement ROOT: the stable, project-contained identity a
// revision belongs to. Every revision row carries a composite FK to (projectId, rootId), so a
// revision lineage CROSSING projects is unrepresentable in PostgreSQL (review finding 2).
model ActivityRequirementRoot {
  id          String                @id // the stable requirementId
  project     Project               @relation(fields: [projectId], references: [id])
  projectId   String
  createdAt   DateTime              @default(now())
  createdBy   User                  @relation("requirementRootsCreated", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById String
  revisions   ActivityRequirement[]
  substitutions ApprovedSubstitution[]

  @@unique([projectId, id])
  // Phase 4 Task 3 — pmc-authored labour skill substitutions widening this requirement's §B satisfaction
  approvedSkillSubstitutions ApprovedSkillSubstitution[]
}

// The §11 demand contract (plan §§B/F) — TYPE-NEUTRAL revision rows (correction finding 3).
// APPEND-ONLY: a BEFORE UPDATE OR DELETE trigger (this correction's migration) makes every
// revision row database-immutable; revise/cancel INSERT revision+1 against the same root. The
// common contract keeps only type-neutral fields (§11: quantity + unit + dates + parties);
// material-only specification detail lives in the revision-owned MaterialRequirementSpec.
// Downstream phases FK onto (projectId, requirementId, revision).
model ActivityRequirement {
  id            String                  @id @default(cuid()) // row id (one per revision)
  project       Project                 @relation(fields: [projectId], references: [id])
  projectId     String
  root          ActivityRequirementRoot @relation(fields: [projectId, requirementId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  requirementId String
  revision      Int // 1-based, monotone per requirementId
  activity      Activity                @relation(fields: [projectId, activityId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  activityId    String
  type          RequirementType         @default(material)

  requiredQty Decimal  @db.Decimal(18, 6)
  baseUom     String
  requiredBy  DateTime @db.Date // civil DATE (correction finding 3)
  // the accountable party: an ACTIVE same-project membership (service-validated; FK backstop)
  responsible   Membership? @relation(fields: [projectId, responsibleId], references: [projectId, userId], onDelete: NoAction, onUpdate: NoAction)
  responsibleId String?
  criticality   String      @default("normal") // 'normal' | 'critical'
  tolerance     Decimal?    @db.Decimal(18, 6)
  status        String      @default("open") // 'open' | 'cancelled' (a cancel APPENDS a revision)
  createdAt     DateTime    @default(now())
  createdBy     User        @relation("requirementsCreated", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById   String

  materialSpec     MaterialRequirementSpec?
  labourSpec       LabourRequirementSpec? // Phase 4 Task 1 — the labour detail (type='labour')
  labourSlices     LabourDemandSlice[] // Phase 4 Task 1 — explicit (civilDate, shift, qty) slices
  requisitionLines RequisitionLine[]
  stockLots        StockLot[]

  @@unique([requirementId, revision])
  // the downstream-FK identity (correction finding 2): later phases pin exactly this triple
  @@unique([projectId, requirementId, revision])
  // composite identity so referencing rows can carry (projectId, rowId) FKs (Phase 0 Task 5 pattern)
  @@unique([projectId, id])
  @@index([projectId, activityId])
}

// The MATERIAL-ONLY specification detail of one requirement revision (correction finding 3):
// technical identity (fingerprinted, §B) + AUTHORITATIVE decision provenance (finding 1 —
// SERVER-derived from a real approved/reapproved decision + its selected option; the all-or-none
// rule is a database CHECK). Append-only via the same BEFORE UPDATE OR DELETE trigger.
model MaterialRequirementSpec {
  id            String              @id @default(cuid())
  project       Project             @relation(fields: [projectId], references: [id])
  projectId     String
  requirement   ActivityRequirement @relation(fields: [projectId, requirementId, revision], references: [projectId, requirementId, revision], onDelete: NoAction, onUpdate: NoAction)
  requirementId String
  revision      Int

  // The unit of measure lives ONCE, on the revision row (round-2 finding 4): the fingerprint
  // still hashes it as part of the §B identity, but there is no duplicated column to disagree.
  materialCategory     String
  make                 String
  grade                String
  normalizedAttributes String
  specFingerprint      String

  // AUTHORITATIVE decision provenance — all null (manual spec) or all server-resolved (CHECK).
  // Round-2 finding 2: the triple FKs onto the IMMUTABLE DecisionApprovalRevision register, so
  // a spec can only reference an approval that really happened, for a real selected option.
  decision         Decision?                 @relation(fields: [projectId, decisionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  decisionId       String?
  approvalRevision DecisionApprovalRevision? @relation(fields: [projectId, decisionId, decisionVersion, optionKey], references: [projectId, decisionId, version, optionKey], onDelete: NoAction, onUpdate: NoAction)
  decisionVersion  Int?
  optionKey        String?

  @@unique([projectId, requirementId, revision])
  @@index([projectId, specFingerprint])
}

// Phase 3 Task 6 — an ACTIVE substitution admits stock of `toFingerprint` as satisfying a
// requirement whose §B identity is `fromFingerprint` (plan §B satisfaction rule). Keyed on the
// requirement ROOT (stable across revisions), pmc authority, audited, event-bearing. Revocation
// NEVER deletes — it stamps `revokedAt`; coverage re-derives WITHOUT the substitution from that
// point on. `coverageFor` (inventory) reads it ONLY indirectly: activities resolves each
// requirement's acceptable fingerprint set and passes it in, keeping the activities→inventory edge.
model ApprovedSubstitution {
  id            String                  @id @default(cuid())
  project       Project                 @relation(fields: [projectId], references: [id])
  projectId     String
  root          ActivityRequirementRoot @relation(fields: [projectId, requirementId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  requirementId String
  fromFingerprint String // the requirement's own §B technical-identity fingerprint
  toFingerprint   String // the substitute stock identity admitted as satisfying it
  reason        String
  approvedBy    User     @relation("substitutionsApproved", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedById  String
  at            DateTime @default(now())
  // revocation (append-in-place: the row survives, coverage re-derives without it)
  revokedAt     DateTime?
  revokedBy     User?     @relation("substitutionsRevoked", fields: [revokedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revokedById   String?
  revokeReason  String?

  @@index([projectId, requirementId])
  @@index([projectId, toFingerprint])
  // Task 6 correction (F2): a PARTIAL unique index on
  // (projectId, requirementId, fromFingerprint, toFingerprint) WHERE "revokedAt" IS NULL forbids a
  // second ACTIVE row for the same material pair (revoked rows are excluded, so history survives and
  // re-approval after revocation is allowed). Prisma cannot express a partial index, so it lives in
  // migration 20270103000000_phase3_t6_correction (like the other DB-only Phase-3 constructs).
}


// ─── Phase 3 Task 2 — the procurement module (plan §§F/G/H) ────────────────────────────────
// Vendor is ORG-scoped — the ONE exception to the every-table-carries-projectId rule, because
// a vendor is an organization-level party (§H). Project reach is ONLY the additive
// ProjectVendor binding below, whose org provably matches both sides.
model Vendor {
  id          String   @id @default(cuid())
  org         Org      @relation(fields: [orgId], references: [id])
  orgId       String
  name        String
  contact     String?
  gstin       String?
  createdAt   DateTime @default(now())
  createdBy   User     @relation("vendorsCreated", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById String
  // Phase 6 unit 6.1a (§A) — the canonical firm this commercial counterparty IS. A foreign
  // key, not a read: procurement gains no `dependsOn` edge from holding it.
  partyId     String
  party       ExternalParty @relation(fields: [orgId, partyId], references: [orgId, id], onDelete: NoAction, onUpdate: NoAction)

  bindings ProjectVendor[]
  // Back-relation for `ProjectVendor.vendorParty` — the binding's party copy is bound
  // THROUGH this vendor's own party, not directly to `ExternalParty`.
  partyBoundBindings ProjectVendor[] @relation("projectVendorParty")

  @@unique([orgId, id])
  @@index([orgId, partyId])
  // The candidate key `ProjectVendor` binds its own party copy through, so the copy is
  // provably the vendor's rather than an independently settable value.
  @@unique([orgId, id, partyId])
}

// §H — a vendor's explicit reach into ONE project. The composite FKs bind the SAME orgId to
// the vendor AND the project, so a cross-org binding is unrepresentable in PostgreSQL; every
// procurement row references (projectId, vendorId) THROUGH this binding.
model ProjectVendor {
  id        String   @id @default(cuid())
  projectId String
  orgId     String
  project   Project  @relation("projectVendorProject", fields: [orgId, projectId], references: [orgId, id], onDelete: NoAction, onUpdate: NoAction)
  vendor    Vendor   @relation(fields: [orgId, vendorId], references: [orgId, id], onDelete: NoAction, onUpdate: NoAction)
  vendorId  String
  // Phase 6 unit 6.1a (§A) — the party copy, bound THROUGH the vendor's own party rather
  // than to `ExternalParty` directly. A same-org row could otherwise bind project A to
  // vendor V1 while mirroring a different party P2, and the resolver would grant P2 access
  // to V1's project records — or would have to read procurement to re-check, which is what
  // the orgs-owned mirror exists to avoid.
  partyId   String
  // ON UPDATE CASCADE, matching the migration: the copy is DERIVED and must follow its source, or
  // 6.1b cannot repoint an already-bound vendor in any order. Declared here because the schema is
  // what a generated migration diffs against — SQL-only would drift straight back.
  vendorParty Vendor @relation("projectVendorParty", fields: [orgId, vendorId, partyId], references: [orgId, id, partyId], onDelete: NoAction, onUpdate: Cascade)
  party     ExternalParty @relation(fields: [orgId, partyId], references: [orgId, id], onDelete: NoAction, onUpdate: NoAction)
  boundAt   DateTime @default(now())
  boundBy   User     @relation("vendorsBound", fields: [boundById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  boundById String

  partySources ProjectPartyVendorSource[]

  quotes         VendorQuote[]
  purchaseOrders PurchaseOrder[]
  // Phase 5 Task 4 (§F) — the bills this counterparty has claimed on this project
  vendorBills    VendorBill[]
  // Phase 5 Task 6C (§H) — money paid to this counterparty ahead of any certified claim
  advances       VendorAdvance[]

  @@unique([projectId, vendorId])
  @@unique([projectId, id])
  @@index([orgId, partyId])
  // The candidate key `ProjectPartyVendorSource` binds through.
  @@unique([orgId, projectId, partyId, id])
  // §A: the same one-party-one-binding-per-project seal. Implied by `(projectId, vendorId)`
  // only while `partyId` is the vendor's — 6.1b's merge repoints it, and then it is not.
  @@unique([projectId, partyId])
}

// §F — a demand batch against pinned requirement revisions. CAS state machine:
// draft → submitted → approved | rejected; approved → closed (all lines ordered or cancelled).
model Requisition {
  id             String    @id @default(cuid())
  project        Project   @relation(fields: [projectId], references: [id])
  projectId      String
  title          String
  notes          String?
  status         String    @default("draft") // draft|submitted|approved|rejected|closed
  createdAt      DateTime  @default(now())
  createdBy      User      @relation("requisitionsCreated", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById    String
  submittedById  String? // transition attribution (audited + event-attributed, like Decision.approvedById)
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  closedAt       DateTime?

  lines          RequisitionLine[]
  rfqs           Rfq[]
  purchaseOrders PurchaseOrder[]

  @@unique([projectId, id])
}

// §F bound 1 — ONE allocation of base-UOM quantity against a pinned requirement revision
// (the Task-1 composite triple FK is the downstream target). Σ active allocations per
// revision ≤ its required qty — enforced in-transaction with the revision locked FOR UPDATE.
model RequisitionLine {
  id            String              @id @default(cuid())
  projectId     String
  requisition   Requisition         @relation(fields: [projectId, requisitionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  requisitionId String
  requirement   ActivityRequirement @relation(fields: [projectId, requirementId, revision], references: [projectId, requirementId, revision], onDelete: NoAction, onUpdate: NoAction)
  requirementId String
  revision      Int
  qty           Decimal             @db.Decimal(18, 6) // in the revision's base UOM (single source)
  status        String              @default("open") // open|ordered|cancelled — 'ordered' = fully allocated to live POs (Task 3); open+ordered BOTH count toward §F bound 1
  cancelledAt   DateTime?
  cancelledById String?

  quoteLines VendorQuoteLine[]
  poLines    PurchaseOrderLine[]

  @@unique([projectId, id])
  // F4 correction: the FK target sealing a PO line's frozen requirement pin to ITS line's real pin
  @@unique([projectId, id, requirementId, revision])
  // F4-r2: the FK target sealing quote/PO line CONTAINMENT to their parent requisition
  @@unique([projectId, requisitionId, id])
  @@index([projectId, requirementId, revision])
}

// §F — an RFQ issued from an approved requisition: issued → closed (quotes in or expired).
model Rfq {
  id            String      @id @default(cuid())
  projectId     String
  requisition   Requisition @relation(fields: [projectId, requisitionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  requisitionId String
  status        String      @default("issued") // issued|closed
  issuedAt      DateTime    @default(now())
  issuedBy      User        @relation("rfqsIssued", fields: [issuedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  issuedById    String
  closedAt      DateTime?

  quotes     VendorQuote[]
  comparison QuoteComparison?

  @@unique([projectId, id])
  // F4 correction: the FK target letting the comparison seal its requisition provenance
  @@unique([projectId, id, requisitionId])
}

// §F — one vendor's quote on an RFQ, reached THROUGH the ProjectVendor binding (§H).
// recorded → superseded (a newer quote from the same vendor) | expired (validity passed).
model VendorQuote {
  id              String        @id @default(cuid())
  projectId       String
  rfq             Rfq           @relation(fields: [projectId, rfqId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  rfqId           String
  // F4-r2: the RFQ's requisition, denormalized (immutable — the lifecycle trigger freezes it)
  // and FK-sealed (projectId, rfqId, requisitionId) -> Rfq, so every quote LINE can be
  // containment-sealed to this same requisition.
  requisitionId   String
  binding         ProjectVendor @relation(fields: [projectId, vendorId], references: [projectId, vendorId], onDelete: NoAction, onUpdate: NoAction)
  vendorId        String
  status          String        @default("recorded") // recorded|superseded|expired
  validUntil      DateTime      @db.Date
  leadTimeDays    Int?
  paymentTerms    String?
  warrantyTerms   String?
  historicalScore Decimal?      @db.Decimal(5, 2)
  recordedAt      DateTime      @default(now())
  recordedBy      User          @relation("quotesRecorded", fields: [recordedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recordedById    String

  lines               VendorQuoteLine[]
  comparisonsSelected QuoteComparison[]

  @@unique([projectId, id])
  // F4 correction: the FK target proving a comparison's selection is a quote of the SAME
  // rfq AND that the recorded selectedVendorId is truly that quote's vendor. Rows are
  // lifecycle-only at PostgreSQL (status may transition; everything else is frozen), and
  // at most ONE 'recorded' quote per (projectId, rfqId, vendorId) — a partial unique index
  // (SQL migration; not expressible in Prisma).
  @@unique([projectId, rfqId, vendorId, id])
  // F4-r2: the FK target sealing each quote line's containment to THIS quote's requisition
  @@unique([projectId, id, requisitionId])
  @@index([projectId, rfqId, vendorId])
}

// §F quote normalization — the comparison inputs, per quoted requisition line. Money is
// Decimal in the project base currency (INR, Stage 1); landedCost is the comparison metric.
model VendorQuoteLine {
  id                   String          @id @default(cuid())
  projectId            String
  quote                VendorQuote     @relation(fields: [projectId, quoteId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  quoteId              String
  requisitionLine      RequisitionLine @relation(fields: [projectId, requisitionLineId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  requisitionLineId    String
  // F4-r2: containment — this line's requisition, FK-sealed BOTH to the parent quote's
  // requisition and to the requisition line's own requisition (a foreign line is
  // unrepresentable; rows are fully append-only).
  requisitionId        String
  baseRate             Decimal         @db.Decimal(18, 2)
  taxAmount            Decimal         @db.Decimal(18, 2)
  freightAmount        Decimal         @db.Decimal(18, 2)
  landedCost           Decimal         @db.Decimal(18, 2)
  quotedMake           String
  matchesSpecification Boolean
  sampleCompliant      Boolean?
  vendorStockQty       Decimal?        @db.Decimal(18, 6)
  deliveryPromise      DateTime?       @db.Date

  @@unique([quoteId, requisitionLineId])
  @@unique([projectId, id])
}

// §F — the recorded comparison decision: draft → approved, carrying REAL authority + reason;
// a non-lowest landed-total selection additionally demands an explicit justification. Only
// COMPLETE quotes (covering every open requisition line) are eligible; an offered material
// that does not match the approved specification cannot be selected (F1/F3 corrections —
// substitutions and partial awards are unsupported until their tasks land). Approval is
// SEALED at PostgreSQL: identity is frozen, only the approval columns may be written, and
// an approved row can never change again.
model QuoteComparison {
  id               String       @id @default(cuid())
  projectId        String
  rfq              Rfq          @relation(fields: [projectId, rfqId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  rfqId            String
  // F4 correction: the RFQ's requisition, denormalized + FK-sealed (projectId, rfqId,
  // requisitionId) -> Rfq so a purchase order can seal its full provenance chain.
  requisitionId    String
  status           String       @default("draft") // draft|approved
  selectedQuote    VendorQuote? @relation(fields: [projectId, selectedQuoteId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  selectedQuoteId  String?
  selectedVendorId String?
  reason           String?
  justification    String? // required when the selection is not the lowest landed total
  createdAt        DateTime     @default(now())
  createdBy        User         @relation("comparisonsCreated", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById      String
  approvedById     String?
  approvedAt       DateTime?

  @@unique([projectId, rfqId]) // one comparison per RFQ
  @@unique([projectId, id])
  // F4-r2: STATUS joins the provenance key, so a purchase order can only ever reference an
  // APPROVED selection (its comparisonStatus column is CHECK-pinned to 'approved').
  @@unique([projectId, id, selectedVendorId, requisitionId, status], map: "QuoteComparison_provenance_status_key")
}

// §F Task 3 — the PO ROOT: immutable identity (vendor through the §H binding + source
// requisition + comparison provenance). Lifecycle lives on VERSION rows; the root never
// changes (DB append-only trigger, the ActivityRequirementRoot pattern).
model PurchaseOrder {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation("purchaseOrderProject", fields: [projectId], references: [id])
  binding       ProjectVendor @relation(fields: [projectId, vendorId], references: [projectId, vendorId], onDelete: NoAction, onUpdate: NoAction)
  vendorId      String
  requisition   Requisition   @relation(fields: [projectId, requisitionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  requisitionId String
  comparisonId  String // provenance: the APPROVED comparison this PO executes
  // F4-r2: CHECK-pinned to 'approved' and part of the provenance FK — a PO referencing a
  // draft comparison is unrepresentable at PostgreSQL, not merely refused by the service.
  comparisonStatus String     @default("approved")
  createdAt     DateTime      @default(now())
  createdBy     User          @relation("purchaseOrdersCreated", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById   String

  versions PurchaseOrderVersion[]
  // Phase 5 Task 4 (§F) — the lines carrying this order's pinned identity
  pinnedLines PurchaseOrderLine[]

  @@unique([projectId, id])
  // F4-r2: the FK target sealing every VERSION's containment to this PO's requisition
  @@unique([projectId, id, requisitionId])
  // Phase 5 Task 4 (§F vendor pinning) — the FK target proving a LINE's copied `vendorId` is
  // this order's own vendor, not a value someone wrote onto the line.
  @@unique([projectId, id, vendorId])
}

// §F — ONE version of a PO. draft → issued → partially_received → completed;
// issued → amended (a NEW version row is issued; THIS row's frozen snapshot is retained
// verbatim) | cancelled (only with zero accepted receipts — otherwise close-short with
// reason). Reissue = the new version referencing the amended one via supersedesVersion.
// DB triggers freeze everything except the lifecycle columns; rows are never deleted.
model PurchaseOrderVersion {
  id                String        @id @default(cuid())
  projectId         String
  po                PurchaseOrder @relation(fields: [projectId, poId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  poId              String
  version           Int
  // F4-r2: the PO root's requisition, denormalized (frozen by the lifecycle trigger) and
  // FK-sealed to the root, so every LINE can be containment-sealed in turn.
  requisitionId     String
  status            String        @default("draft") // draft|issued|partially_received|completed|amended|cancelled|closed_short
  supersedesVersion Int? // the amended prior version this reissue replaces
  issuedById        String? // transition attribution (Decision.approvedById precedent)
  issuedAt          DateTime?
  amendedAt         DateTime?
  amendReason       String?
  cancelledAt       DateTime?
  cancelReason      String?
  closedShortAt     DateTime?
  closeShortReason  String?
  createdAt         DateTime      @default(now())
  createdBy         User          @relation("poVersionsCreated", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById       String

  lines PurchaseOrderLine[]

  @@unique([poId, version])
  @@unique([projectId, id])
  // F4-r2: the FK target sealing every LINE's containment to this version's requisition
  @@unique([projectId, id, requisitionId])
  // Phase 5 Task 4 (§F vendor pinning) — the FK target proving a LINE's copied
  // `purchaseOrderId` is its own version's order.
  @@unique([projectId, id, poId])
}

// §F — a PO line's FROZEN commercial snapshot, copied from the comparison-approved quote
// line at creation. F2 correction — the purchase-UOM triple is EXPLICIT and dimensionally
// sound: the caller orders `purchaseQty` in `purchaseUom`; `conversionToBase` converts one
// purchase unit to base units; `qty` is the DERIVED base quantity = purchaseQty ×
// conversionToBase (DB CHECK), and every §F allocation bound uses it. `rate` is the quote's
// per-BASE-unit rate, so committedAmountBase = rate × purchaseQty × conversionToBase +
// taxAmount + freightAmount ( = rate × qty + tax + freight) is exact. For a PARTIAL order,
// taxAmount/freightAmount carry the ordered share of the quote line's amounts, prorated by
// base quantity and rounded to 2 dp (documented Stage-1 treatment). A DB trigger rejects
// any UPDATE except receivedQty (the procurement-owned received-progress fact Task-4
// receipts append through the participant) and the issuance-time approvedOverage(+reason);
// rows are never deleted. approvedOverage is the ONLY §F bound-3 headroom: set by pmc at
// issuance/amendment with a reason, never afterwards. The (requisitionLineId,
// requirementId, revision) pin is FK-sealed to the requisition line's own pin (F4).
model PurchaseOrderLine {
  id                  String               @id @default(cuid())
  projectId           String
  poVersion           PurchaseOrderVersion @relation(fields: [projectId, poVersionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  poVersionId         String
  requisitionLine     RequisitionLine      @relation(fields: [projectId, requisitionLineId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  requisitionLineId   String
  // F4-r2: containment — this line's requisition, FK-sealed BOTH to the parent version's
  // requisition and to the requisition line's own requisition (a foreign line is
  // unrepresentable; the frozen trigger covers it).
  requisitionId       String
  requirementId       String // frozen requirement pin (FK-sealed to the requisition line's pin)
  revision            Int
  specFingerprint     String // the DEMANDED material identity — always present (material-only pipeline; selection is match-only)
  quotedMake          String?
  uom                 String // the revision's base UOM (single source)
  purchaseUom         String // the vendor's pack/purchase unit label (defaults to the base UOM)
  purchaseQty         Decimal              @db.Decimal(18, 6) // ordered quantity in purchase units (caller-authored)
  conversionToBase    Decimal              @default(1) @db.Decimal(18, 6) // one purchase unit in base units, frozen at creation
  qty                 Decimal              @db.Decimal(18, 6) // DERIVED base quantity = purchaseQty × conversionToBase (DB CHECK)
  rate                Decimal              @db.Decimal(18, 2)
  taxAmount           Decimal              @db.Decimal(18, 2)
  freightAmount       Decimal              @db.Decimal(18, 2)
  landedAmount        Decimal              @db.Decimal(18, 2) // the quote line's landed metric, copied verbatim
  committedAmountBase Decimal              @db.Decimal(18, 2)
  approvedOverage     Decimal              @default(0) @db.Decimal(18, 6)
  overageReason       String?
  receivedQty         Decimal              @default(0) @db.Decimal(18, 6)

  // Phase 5 Task 4 (§F) — VENDOR PINNING, copied at line creation and column-frozen with the
  // rest of the snapshot. The obvious spelling of "bind a bill line to its vendor" does not
  // work: the vendor lives on the PO ROOT, and PostgreSQL cannot express a transitive join as a
  // foreign key, so a composite FK "carrying vendorId to the line" is unimplementable and would
  // silently degrade to a service check. A same-project FK alone only stops a CROSS-PROJECT
  // line — within one project Vendor A's bill could still name Vendor B's PO line, pass the
  // ordered and accepted checks, and attribute a payable amount to the wrong counterparty.
  //
  // These two columns are not new truth: they are the version→root chain this row already
  // references, copied so PostgreSQL can reach it. Both are FK-sealed BACK to that chain
  // (`(projectId, poVersionId, purchaseOrderId)` → the version's own order, and
  // `(projectId, purchaseOrderId, vendorId)` → that order's own vendor), so the copy cannot
  // disagree with the source it was copied from.
  purchaseOrder   PurchaseOrder @relation(fields: [projectId, purchaseOrderId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  purchaseOrderId String
  vendorId        String

  commitments DeliveryCommitment[]
  // Phase 3 Task 4 — received batches + receipt ledger rows against this line
  stockLots         StockLot[]
  stockTransactions StockTransaction[]
  // Phase 5 Task 1 (§C) — the commercial-owned cost-head attribution history for this line
  attributions      CommitmentAttribution[]
  // Phase 5 Task 4 (§F) — the vendor claim lines drawn against this order line
  billLines         VendorBillLine[]

  @@unique([projectId, id])
  // Phase 5 Task 4 (§F) — the FK target a bill line binds to, so a claim can only ever name a
  // PO line belonging to ITS OWN vendor. Unique because `(projectId, id)` already is: widening a
  // unique key adds an FK target, it never constrains what may be stored.
  @@unique([projectId, id, vendorId])
  @@index([projectId, requisitionLineId])
}

// §F — a vendor's delivery commitment on a PO line: committed → revised* → fulfilled |
// defaulted. Every revision APPENDS a dated promise row — full history, nothing
// overwritten; the LATEST promise drives §A at-risk (Task 6).
model DeliveryCommitment {
  id          String            @id @default(cuid())
  projectId   String
  poLine      PurchaseOrderLine @relation(fields: [projectId, poLineId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  poLineId    String
  status      String            @default("committed") // committed|revised|fulfilled|defaulted
  createdAt   DateTime          @default(now())
  createdBy   User              @relation("commitmentsCreated", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById String
  fulfilledAt DateTime?
  defaultedAt DateTime?

  promises DeliveryPromise[]
  // Phase 3 Task 4 — received batches + receipt ledger rows fulfilling this commitment
  stockLots         StockLot[]
  stockTransactions StockTransaction[]

  @@unique([projectId, id])
}

// §F — ONE dated promise in a commitment's append-only history (PG BEFORE UPDATE/DELETE
// trigger). seq is monotone per commitment; the initial promise carries no reason.
model DeliveryPromise {
  id           String             @id @default(cuid())
  projectId    String
  commitment   DeliveryCommitment @relation(fields: [projectId, commitmentId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  commitmentId String
  seq          Int
  promisedDate DateTime           @db.Date
  reason       String? // why the promise moved (required for every revision; null on the initial promise)
  recordedAt   DateTime           @default(now())
  recordedBy   User               @relation("promisesRecorded", fields: [recordedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recordedById String

  @@unique([commitmentId, seq])
  @@unique([projectId, id])
}

// ─── Phase 3 Task 4 — the inventory module (plan §C) ───────────────────────────────────────
// A StockLot is ONE immutable received batch (a BEFORE UPDATE OR DELETE trigger blocks every
// change). It carries the full §B MaterialSpecificationRef — technical identity + decision
// provenance — FROZEN at receipt from the pinned requirement revision the received PO line
// executes (selection is match-only, so compliant receipts carry the demanded identity), plus
// provenance FKs to the PO line and the delivery commitment the receipt fulfilled. The lot has
// NO quantity and NO location column: physical truth lives ONLY in the append-only ledger
// below, keyed (projectId, storeLocation, stockLotId).
model StockLot {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  poLine       PurchaseOrderLine  @relation(fields: [projectId, poLineId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  poLineId     String
  commitment   DeliveryCommitment @relation(fields: [projectId, commitmentId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  commitmentId String

  // the PO line's frozen requirement pin, FK-sealed so the §B ref below provably belongs to it
  requirement   ActivityRequirement @relation(fields: [projectId, requirementId, revision], references: [projectId, requirementId, revision], onDelete: NoAction, onUpdate: NoAction)
  requirementId String
  revision      Int

  // §B MaterialSpecificationRef — technical identity, verbatim from the revision's spec
  materialCategory     String
  make                 String
  grade                String
  normalizedAttributes String
  baseUom              String
  specFingerprint      String
  // §B provenance (all null = manual spec) — copied from the revision's spec at receipt
  decisionId      String?
  decisionVersion Int?
  optionKey       String?

  receivedAt   DateTime @default(now())
  receivedBy   User     @relation("stockLotsReceived", fields: [receivedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receivedById String

  transactions StockTransaction[]
  issues       MaterialIssue[]

  @@unique([projectId, id])
  @@index([projectId, specFingerprint])
  @@index([projectId, poLineId])
}

// The §C append-only stock ledger — the ONLY place a quantity moves; NO current-quantity
// column exists anywhere. Every row moves `qty` (base UOM, > 0) from `fromBucket` to
// `toBucket` (null = outside the store), so buckets derive by ONE generic fold per stock key.
// Database CHECKs pin the per-type movement (a receipt row that fills anything but quarantine
// is unrepresentable); a BEFORE UPDATE OR DELETE trigger makes rows immutable; a reversal
// trigger proves each reversal row is the exact inverse of the row it references (§C rule
// iii). `sourceCommandId` records the CommandExecution ledger row that appended the row (§C
// rule ii — a replayed command re-runs nothing, so it appends nothing).
model StockTransaction {
  id            String   @id @default(cuid())
  project       Project  @relation(fields: [projectId], references: [id])
  projectId     String
  lot           StockLot @relation(fields: [projectId, lotId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  lotId         String
  storeLocation String
  type          String // receipt|acceptance|rejection|vendor_return|adjustment|reversal (Task-4 vocabulary; CHECK)
  qty           Decimal  @db.Decimal(18, 6)
  fromBucket    String? // quarantine|acceptedOnHand|rejected (CHECK); null = from outside the store
  toBucket      String? // same domain; null = leaves the store

  // receipt provenance (CHECK: exactly the receipt rows carry both)
  poLine       PurchaseOrderLine?  @relation(fields: [projectId, poLineId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  poLineId     String?
  commitment   DeliveryCommitment? @relation(fields: [projectId, commitmentId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  commitmentId String?

  // Task 5 — activity linkage (CHECK: exactly the reservation/release/issue/consumption/
  // site-return/wastage rows carry it; reversals copy their target's, trigger-verified)
  activity   Activity? @relation(fields: [projectId, activityId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  activityId String?
  // Task 5 — the §E MaterialIssue this row belongs to: the issue row itself plus every
  // custody movement (consumption/site-return/wastage) recorded AGAINST it
  issue   MaterialIssue? @relation(fields: [projectId, issueId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  issueId String?
  // Task 5 — a transfer's DESTINATION stock key (CHECK: exactly the transfer rows carry it);
  // the row's own storeLocation is the source, so ONE row moves acceptedOnHand between keys
  toStoreLocation String?

  // reversal linkage (CHECK: exactly the reversal rows carry it; partial unique — once each)
  reversedTx   StockTransaction?  @relation("stockReversal", fields: [projectId, reversedTxId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  reversedTxId String?
  reversedBy   StockTransaction[] @relation("stockReversal")

  // quality decision facts (CHECK: acceptance carries result + evidence; rejection evidence)
  qualityResult   String?
  evidenceMedia   Media?  @relation(fields: [projectId, evidenceMediaId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  evidenceMediaId String?
  reason          String? // required on adjustment + reversal (CHECK)

  // Tasks 4–5 integrity correction (F1) — every ledger row cites the CommandExecution that
  // appended it (§C rule ii): REQUIRED (a server one-shot command backs even an unkeyed call)
  // and project-contained by the composite FK (a cross-project source command is unrepresentable).
  sourceCommand   CommandExecution @relation(fields: [projectId, sourceCommandId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  sourceCommandId String
  recordedAt      DateTime          @default(now())
  recordedBy      User              @relation("stockTransactionsRecorded", fields: [recordedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recordedById    String

  @@unique([projectId, id])
  @@index([projectId, lotId, storeLocation])
  @@index([projectId, poLineId])
  @@index([projectId, activityId])
  @@index([projectId, issueId])
}

// Task 5 — the §E-CANONICAL record of material that LEFT THE STORE for an activity ("an
// issue is not a delivery"). Immutable (BEFORE UPDATE OR DELETE trigger): corrections
// reverse the underlying ledger rows (§C rule iii), never edit or delete this record, so a
// daily-log reference to an issue id can never be orphaned. The Daily Log screen reads
// these through inventory's `stock.issues` query — nothing is copied into SiteMaterial.
model MaterialIssue {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  lot           StockLot @relation(fields: [projectId, lotId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  lotId         String
  storeLocation String // the §C stock key the material left
  activity      Activity @relation(fields: [projectId, activityId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  activityId    String
  qty           Decimal  @db.Decimal(18, 6) // base UOM

  issuedAt   DateTime @default(now())
  issuedBy   User     @relation("materialIssuesIssued", fields: [issuedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  issuedById String

  transactions StockTransaction[]

  @@unique([projectId, id])
  @@index([projectId, activityId])
  @@index([projectId, lotId])
}

model Decision {
  id             String           @id // e.g. "DL-014"
  project        Project          @relation(fields: [projectId], references: [id])
  projectId      String
  title          String
  room           String // display fallback / legacy; the node path is authoritative when nodeId is set
  node           ProjectNode?     @relation(fields: [projectId, nodeId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  nodeId         String?
  status         DecisionStatus   @default(pending)
  ageDays        Int?
  photoSwatch    String
  approvedOption String?
  material       String?
  approver       String? // human-readable approver line (the caller's REAL name since Phase 1 Task 2)
  approvedById   String? // the approving user's id — real attribution (Phase 1 Task 2)
  onBehalfOf     String? // 'client' when a PMC approves on the client's behalf — never disguised
  // Phase 6 task 4b expansion. The default preserves every older writer's client-held behavior.
  // Holder state can be supplied before publication; the migration freezes it once published.
  deciderKind         DeciderKind @default(client)
  deciderMembershipId String?
  deciderMembership   Membership? @relation("DecisionDeciders", fields: [projectId, deciderMembershipId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  // The optional tuple freezes the holder represented by an approval act. It remains nullable
  // until tuple-writing application code has replaced every older writer.
  approvedDeciderKind         DeciderKind?
  approvedDeciderMembershipId String?
  approvedDeciderLabel        String?
  date           String? // display date, e.g. "12 Jun 2026"
  cost           Int? // rupees
  createdAt      DateTime         @default(now())
  // Draft → Publish lifecycle. While `publishedAt` is null the decision is a private
  // DRAFT: the snapshot delivers it only to its author (`authorId`), it never notifies
  // the client, and the app treats it as weightless (no pending count, no gate). Publish
  // sets `publishedAt` and fires the normal side-effects. Both nullable/additive so the
  // migration is safe on the live DB; existing rows (published) are backfilled to createdAt.
  publishedAt    DateTime?
  authorId       String?
  // Phase 6 task 4a — the withdrawal evidence, written ONCE by `decisions.withdraw` and frozen
  // by trigger with the terminal status (rewritten attribution is forged history). All three are
  // required (and only legal) when status='withdrawn' — the coherence trigger enforces both
  // directions. `withdrawnById` is FK-backed to a REAL member of THIS project (the same identity
  // discipline as `completionRequestedById`); `withdrawnByName` denormalizes the display identity
  // at withdraw time (the `approver` precedent), so the serialized register never joins for it.
  withdrawnAt     DateTime?
  withdrawnById   String?
  withdrawnByName String?
  withdrawReason  String?
  withdrawnBy     Membership? @relation("DecisionWithdrawals", fields: [projectId, withdrawnById], references: [projectId, userId], onDelete: NoAction, onUpdate: NoAction)

  options           DecisionOption[]
  events            DecisionEvent[]
  approvalRevisions DecisionApprovalRevision[]
  materialSpecs     MaterialRequirementSpec[]
  labourSpecs       LabourRequirementSpec[] // Phase 4 Task 1 — labour demand provenance
  changeRequests ChangeRequest[]
  activities     Activity[]
  materials      SiteMaterial[]
  media          Media[]
  drawings       Drawing[]
  optionTouches  DecisionOptionTouch[] // phase6-4a round 13 — per-tx option touch notes
  legacyApproval DecisionLegacyApproval? @ignore

  // composite identity so referencing models can carry (projectId, decisionId)
  // foreign keys — the DB itself rejects a cross-project link (Phase 0 Task 5)
  @@unique([projectId, id])
  // pre-existing in the DB since 20260715000000_add_location_tree; declared here so
  // the schema matches the database exactly (drift found by `prisma migrate diff`)
  @@index([nodeId])
  @@index([projectId, deciderMembershipId], map: "Decision_deciderMembershipId_idx")
  @@index([projectId, approvedDeciderMembershipId], map: "Decision_approvedDeciderMembershipId_idx")
}

// Migration-owned evidence for approvals that predate tuple-writing application code. Rows are
// stamped before the migration closes every application-writable door on this table.
model DecisionLegacyApproval {
  decisionId String   @id
  stampedAt  DateTime @default(now()) @db.Timestamptz(6)
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // The application has no delegate for migration-owned evidence. `@@ignore` keeps this
  // database-only unit out of service/module wiring while preserving the table declaration.
  @@ignore
}

model DecisionOption {
  id          String   @id @default(cuid())
  decision    Decision @relation(fields: [decisionId], references: [id])
  decisionId  String
  label       String
  optionKey   String
  material    String
  delta       Int // rupees
  swatch      String
  photoUrl    String? // uploaded sample photo (media url); swatch is the fallback
  recommended Boolean  @default(false)
  order       Int      @default(0)

  approvalRevisions DecisionApprovalRevision[]

  // the approval register (and requirement provenance behind it) pins an option by
  // (decisionId, optionKey) — the pair is a database-enforced candidate key
  @@unique([decisionId, optionKey])
}

// Phase 6 task 4a (round 13) — the per-transaction OPTION TOUCH NOTE behind the withdrawal
// entry seal. Written ONLY by the `DecisionOption_t4a_touch` DB trigger (never by application
// code): every option write records (decisionId, txid_current()), and the withdrawal-entry
// seal refuses a decision whose options were touched in the SAME transaction. The round-12
// note lived in pg_temp, which the writing session could DROP with no privilege at all; this
// real table's guard trigger refuses same-transaction erasure, so blinding the seal now needs
// ALTER TABLE ... DISABLE TRIGGER — the same ownership privilege as every sanctioned bypass.
// Rows for COMMITTED transactions are inert history, swept by the decision's delete cascade.
model DecisionOptionTouch {
  decisionId String
  txid       BigInt
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([decisionId, txid])
}

// The IMMUTABLE approval register of a decision (Phase 3 Task 1 correction round 2, finding 1).
// One row PER approval/reapproval, created in the SAME transaction as the approve command.
// Rows are database-immutable (BEFORE UPDATE OR DELETE trigger); `version` is monotonic per
// decision INCLUDING unprovable legacy history — the service allocates
// max(head revision, recorded approval events) + 1, so a legacy approval's first reapproval is
// version 2, never a colliding version 1. Requirement provenance (MaterialRequirementSpec) FKs
// onto (projectId, decisionId, version, optionKey): a spec can only ever reference an approval
// that REALLY happened, for an option the decision REALLY has. `decisions.approvedRef` serves
// provenance from the head row alone — never from event counts or label matching.
model DecisionApprovalRevision {
  id           String         @id
  projectId    String
  decision     Decision       @relation(fields: [projectId, decisionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  decisionId   String
  version      Int
  option       DecisionOption @relation(fields: [decisionId, optionKey], references: [decisionId, optionKey], onDelete: NoAction, onUpdate: NoAction)
  optionKey    String
  approvedAt   DateTime
  approvedBy   User?          @relation("approvalRevisionsApproved", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedById String? // null only on backfilled legacy rows whose approver was never recorded
  onBehalfOf   String? // 'client' when a PMC recorded the client's consent — never disguised

  materialSpecs MaterialRequirementSpec[]
  labourSpecs   LabourRequirementSpec[] // Phase 4 Task 1 — labour demand provenance (same register)

  @@unique([decisionId, version])
  // the provenance FK target: version AND option bind together to one immutable approval fact
  // (explicit name — the generated one exceeds PostgreSQL's 63-char identifier limit)
  @@unique([projectId, decisionId, version, optionKey], map: "DecisionApprovalRevision_provenance_target_key")
}

// Append-only lifecycle + audit log for a decision.
model DecisionEvent {
  id         String   @id @default(cuid())
  decision   Decision @relation(fields: [decisionId], references: [id])
  decisionId String
  type       String // drafted | issued | approved | reapproved | change_requested | change_withdrawn
  actor      String // legacy display label; actorName is authoritative on new rows
  actorId    String? // real user identity (Phase 1 Task 2); null on pre-Phase-1 rows
  actorName  String?
  actorRole  String? // the role HELD AT ACTION TIME (gate finding 6) — a later role change never rewrites history
  at         DateTime @default(now())
  payload    Json?
}

// One reopening of a locked decision. Status machine: 'open' -> 'resolved' (by
// client re-approval) | 'withdrawn' (by the requester or PMC). EXACTLY ONE open
// request per decision is enforced by a partial unique index —
// "ChangeRequest_one_open_per_decision" ON ("decisionId") WHERE status = 'open'
// (raw SQL in 20260910000000_phase1_change_control; not expressible in Prisma).
// Legacy rows were backfilled: 'pending' -> 'open' only while their decision was
// still reopened, else 'resolved' with a null resolution.
model ChangeRequest {
  id             String    @id @default(cuid())
  decision       Decision  @relation(fields: [decisionId], references: [id])
  decisionId     String
  reason         String
  costImpact     Int // rupees
  timeImpactDays Int
  status         String    @default("open")
  requestedById  String? // real requester identity; null on pre-Phase-1 rows
  resolvedById   String?
  resolvedAt     DateTime?
  resolution     String? // 'reapproved' | 'withdrawn'; null on backfilled legacy rows
  createdAt      DateTime  @default(now())
}

model Activity {
  id             String         @id // e.g. "ACT-31"
  project        Project        @relation(fields: [projectId], references: [id])
  projectId      String
  name           String
  zone           String
  status         ActivityStatus @default(not_started)
  // planned/actual as day-offsets from 1 Jun 2026 (LEGACY prototype timeline model —
  // kept for compatibility; the civil dates below are canonical going forward)
  plannedStart   Int
  plannedEnd     Int
  actualStart    Int?
  actualEnd      Int?
  // Real civil dates (Phase 0 Task 6); display strings are derived, never compared
  plannedStartDate DateTime? @db.Date
  plannedEndDate   DateTime? @db.Date
  actualStartDate  DateTime? @db.Date
  actualEndDate    DateTime? @db.Date
  // Phase 1 Task 5 — the sign-off civil day (set ONLY by closing-inspection
  // approval); actualEndDate above remains the CLAIMED work-end day
  doneAt           DateTime? @db.Date
  // The completion CLAIM: who said the work was finished (an attributable,
  // membership-validated fact — the reject path assigns corrective work from it).
  // Composite FK to Membership — a claimant without a membership on THIS
  // project is impossible even on a direct write (memberships are soft-removed).
  completionRequestedBy     Membership? @relation("CompletionClaims", fields: [projectId, completionRequestedById], references: [projectId, userId], onDelete: NoAction, onUpdate: NoAction)
  completionRequestedById   String?
  completionRequestedByName String?
  completionRequestedAt     DateTime?
  block          String?
  // stored readiness gates; the Decision gate is derived live from the decision
  gateMaterial   GateState @default(na)
  gateTeam       GateState @default(na)
  gateInspection GateState @default(na)
  decision       Decision?      @relation(fields: [projectId, decisionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  decisionId     String?
  phase          Phase?         @relation(fields: [projectId, phaseId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  phaseId        String?
  // Location spine: where this work happens (zone/room/object). NodesService unlinks
  // on node delete; the composite FK forbids a cross-project filing at the database.
  node           ProjectNode?   @relation(fields: [projectId, nodeId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  nodeId         String?
  order          Int            @default(0)
  drawings       Drawing[]
  // Phase 3 Task 5 — stock movements scoped to this activity + the §E issue records
  stockTransactions StockTransaction[]
  materialIssues    MaterialIssue[]
  // inspections whose requirement edge names this activity (Phase 1 Task 4)
  inspections    Inspection[]
  // manual readiness exceptions — attributable, evidenced, EXPIRING (Phase 1 Task 6)
  gateOverrides  GateOverride[]

  @@unique([projectId, id])
  @@index([nodeId])
  requirements ActivityRequirement[]
  labourMismatches LabourMismatch[]
  workOutputs      ActivityWorkOutput[]
  measurements Measurement[]
}

// A manual readiness exception (Phase 1 Task 6): the PMC overrides ONE gate's
// derived value with an attributable, reasoned, optionally evidenced record that
// ALWAYS expires — expiry (or early revocation) restores the derivation. No
// silent flag-flips: every override is audited and serialized in the snapshot.
model GateOverride {
  id         String    @id @default(cuid())
  project    Project   @relation(fields: [projectId], references: [id])
  projectId  String
  // composite FK — an override can only name THIS project's activity
  activity   Activity  @relation(fields: [projectId, activityId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  activityId String
  gate       String // decision | material | team | inspection | drawing
  state      GateState
  reason     String
  actorId    String
  actorName  String
  // optional supporting photo — composite FK, same-project by construction (Task 4 key)
  evidence        Media?  @relation(fields: [projectId, evidenceMediaId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  evidenceMediaId String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([projectId, activityId])
}

// A project phase (Foundation → Structure → MEP → Finishing…). Groups activities
// for phase-level monitoring; planned window as day-offsets (like activities).
model Phase {
  id           String     @id @default(cuid())
  project      Project    @relation(fields: [projectId], references: [id])
  projectId    String
  name         String
  order        Int        @default(0)
  plannedStart Int        @default(0) // LEGACY day-offset (kept for compatibility)
  plannedEnd   Int        @default(0) // LEGACY day-offset (kept for compatibility)
  // Real civil dates (Phase 0 Task 6)
  plannedStartDate DateTime? @db.Date
  plannedEndDate   DateTime? @db.Date
  activities   Activity[]

  // composite identity for the (projectId, phaseId) FK on Activity
  @@unique([projectId, id])
  @@index([projectId])
}

model Inspection {
  id        String           @id // e.g. "INSP-22"
  project   Project          @relation(fields: [projectId], references: [id])
  projectId String
  kind      String // "checklist" (engineer draft) | "review" (submitted to PMC)
  title     String
  zone      String
  by        String?
  date      String // LEGACY display string (derived; never sorted or compared)
  inspectionDate DateTime? @db.Date // real civil date (Phase 0 Task 6)
  submitted Boolean          @default(false)
  decided   Boolean          @default(false)
  // Phase 1 Task 5: the UNAMBIGUOUS closing-sign-off marker (id-pattern matching
  // retired). Approving a closing inspection is what completes its activity.
  closing   Boolean          @default(false)
  // The REQUIREMENT EDGE (Phase 1 Task 4): the Activity this inspection accepts.
  // Composite FK — a cross-project edge is impossible even on a direct write.
  activity   Activity? @relation(fields: [projectId, activityId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  activityId String?
  // Phase 2 Task 10 (Module 3) correction — the INSPECTION-OWNED activity label. A closing inspection's
  // serialized `activityName` was formerly read live off `Activity.name` (a cross-module read the projection
  // could not observe). It is now stored here: set when the closing inspection is created, updated by the
  // inspections participant when the activity is renamed (both append an inspection event), and backfilled
  // from the linked Activity in the correction migration. Null for inspections with no linked activity.
  activityName String?
  // A reinspection names its predecessor and inherits its activityId. AT MOST ONE
  // direct child per rejected inspection — partial unique index
  // "Inspection_one_reinspection_child" ON ("reinspectionOfId") WHERE NOT NULL
  // (raw SQL in 20260930000000_phase1_inspection_evidence).
  reinspectionOf   Inspection?  @relation("Reinspection", fields: [projectId, reinspectionOfId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  reinspectionOfId String?
  reinspections    Inspection[] @relation("Reinspection")
  // WHO must correct the work: an ACTIVE engineer/contractor member (service-validated;
  // the Membership FK is the backstop — memberships are soft-removed, never deleted).
  assignee   Membership? @relation(fields: [projectId, assigneeId], references: [projectId, userId], onDelete: NoAction, onUpdate: NoAction)
  assigneeId String?
  dueDate    DateTime? @db.Date // real civil due date (decide-day + N days, PMC-overridable)
  // attribution (Phase 1 global rule): who submitted / decided
  submittedById   String?
  submittedByName String?
  decidedById     String?
  decidedByName   String?
  // Location spine: where this quality check happens. NodesService unlinks on node
  // delete; the composite FK forbids a cross-project filing at the database.
  node      ProjectNode?     @relation(fields: [projectId, nodeId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  nodeId    String?
  items     InspectionItem[]
  media     Media[]

  @@unique([projectId, id]) // composite identity — tenant-safe reference target (Task 4)
  @@index([nodeId])
}

model InspectionItem {
  id           String            @id @default(cuid())
  inspection   Inspection        @relation(fields: [inspectionId], references: [id])
  inspectionId String
  name         String
  order        Int               @default(0)
  // checklist fields
  state        String? // pass | fail | na
  // DEPRECATED display derivative (Task 4): real evidence is the LINKED Media rows;
  // this counter is never proof and never validated against.
  photos       Int               @default(0)
  note         String            @default("")
  // review fields
  result       InspectionResult?
  swatch       String?
  rejected     Boolean           @default(false)
  media        Media[]

  @@unique([inspectionId, id]) // containment identity for the Media chain (Task 4)
}

model DailyLog {
  id          String         @id @default(cuid())
  project     Project        @relation(fields: [projectId], references: [id])
  projectId   String
  date        String // LEGACY display string (derived; never sorted or compared)
  // The civil day the site work belongs to (Phase 0 Task 6) — "latest log" orders by
  // THIS first; createdAt (the immutable creation instant) is only the tie-breaker.
  logDate     DateTime?      @db.Date
  createdAt   DateTime       @default(now())
  checkedIn   Boolean        @default(false)
  checkinTime String?
  submitted   Boolean        @default(false)
  progress    Int            @default(0)
  crew        CrewRow[]
  materials   SiteMaterial[]
  media       Media[]

  // composite identity for (projectId, dailyLogId) FKs — see Media
  @@unique([projectId, id])
}

model CrewRow {
  id         String   @id @default(cuid())
  dailyLog   DailyLog @relation(fields: [dailyLogId], references: [id])
  dailyLogId String
  trade      String
  count      Int      @default(0)
  order      Int      @default(0)
}

model SiteMaterial {
  id         String    @id @default(cuid())
  // Canonical project ownership (Codex gate finding 4): a material belongs to ONE
  // project directly — the composite FKs below then make every reference (its log,
  // the approving decision, the staging place) provably same-project in PostgreSQL.
  project    Project   @relation(fields: [projectId], references: [id])
  projectId  String
  dailyLog   DailyLog  @relation(fields: [projectId, dailyLogId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  dailyLogId String
  decision   Decision? @relation(fields: [projectId, decisionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  decisionId String?
  name       String
  qty        String
  zone       String
  matched    Boolean   @default(true)
  swatch     String
  photo      Boolean   @default(false)
  // Location spine: where this material was delivered / is staged. NodesService
  // unlinks on node delete; the composite FK forbids a cross-project filing.
  node       ProjectNode? @relation(fields: [projectId, nodeId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  nodeId     String?
  order      Int       @default(0)

  // Phase 3 Task 5 (§E) — the explicit resolution closing this observation (at most one)
  resolution MismatchResolution?

  // referenced identity for the resolution's composite (projectId, siteMaterialId) FK (Task 5)
  @@unique([projectId, id])
  @@index([nodeId])
  @@index([projectId])
}

// Phase 3 Task 5 (§E) — an explicit, audited resolution closing EXACTLY ONE `matched: false`
// observation. The observation row is NEVER edited (it stays `matched: false` as history);
// `siteMaterialId` is UNIQUE here, so a second resolution of the same observation is
// unrepresentable. Immutable (BEFORE UPDATE OR DELETE trigger). The activity's mismatch
// block clears ONLY when no unresolved mismatch observation remains for its decision.
model MismatchResolution {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  siteMaterial   SiteMaterial @relation(fields: [projectId, siteMaterialId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  siteMaterialId String

  resolution String // the disposition, e.g. 'returned-and-replaced'
  reason     String // why this disposition closes the dispute

  resolvedAt   DateTime @default(now())
  resolvedBy   User     @relation("mismatchesResolved", fields: [resolvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolvedById String

  @@unique([projectId, siteMaterialId])
  @@unique([projectId, id])
}

model Notification {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  text      String
  color     String
  time      String // relative label, e.g. "2h ago" / "just now"
  at        DateTime @default(now())
  // Phase 6 task 4a — the decision a decision-notice announces. Notices are DERIVED
  // communication artifacts (the DecisionEvent register is the history), so retiring a
  // now-false pending notice must not depend on matching display text: the writers stamp
  // this and the withdraw transaction deletes by it. Nullable — non-decision notices and
  // legacy rows (retired by exact text shape, multiplicity-guarded) carry none. NOT a
  // relation: a notice may outlive nothing, but a deleted project cascades via projectId
  // and a decision id is a plain stamp, never a join the feed depends on.
  decisionId String?

  @@index([decisionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  projectId String?
  actor     String // legacy display label (role string on pre-Phase-1 rows)
  actorId   String? // real user identity (Phase 1 Task 2); populated going forward
  actorRole String? // the role HELD AT ACTION TIME (gate finding 6)
  action    String
  entity    String
  entityId  String
  at        DateTime @default(now())
  payload   Json?
}

// ── Phase 4 Task 1 — Labour readiness foundation (plan §§B/D/H) ──────────────────────────────
// The labour LEAF module (plan §G, round-3: dependsOn = []). All rows are project-contained; a
// cross-project reference is unrepresentable in PostgreSQL (same-project composite FKs). Every
// Prisma-inexpressible seal — the labour-aware type↔detail correspondence, the labour-spec/slice
// append-only triggers, the demand CHECKs, and the one-active-crew-membership partial unique —
// is added in raw SQL by 20270110000000_phase4_t1_labour.

// Project-contained labour TRADE catalog. A worker's trade and a labour requirement's trade
// reference an entry here by composite (projectId, code) FK, so a code always resolves to a
// real same-project catalog row.
model LabourTrade {
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  code        String
  name        String
  createdAt   DateTime @default(now())
  createdBy   User     @relation("labourTradesCreated", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById String

  workers     Worker[]
  labourSpecs LabourRequirementSpec[]

  @@id([projectId, code])
}

// Project-contained labour SKILL catalog. A worker's skillCodes and a labour requirement's
// optional skillCode are validated in-service against this catalog.
model LabourSkill {
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  code        String
  name        String
  createdAt   DateTime @default(now())
  createdBy   User     @relation("labourSkillsCreated", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById String

  labourSpecs  LabourRequirementSpec[]
  // correction 3 — worker skills are NORMALIZED into WorkerSkill rows FK-bound to this catalog, so
  // PostgreSQL's real FK concurrency semantics (not two racing triggers) keep the reference valid.
  workerSkills WorkerSkill[]

  @@id([projectId, code])
}

// A trusted, project-contained WORKER identity (§H) — the atomic capacity source (round-1).
// activeFrom/activeTo bound the engagement; a revoke stamps revokedAt+revokedById.
model Worker {
  id          String    @id @default(cuid())
  project     Project   @relation(fields: [projectId], references: [id])
  projectId   String
  name        String
  // the worker's primary trade — a same-project catalog entry (composite FK)
  trade       LabourTrade @relation(fields: [projectId, tradeCode], references: [projectId, code], onDelete: NoAction, onUpdate: NoAction)
  tradeCode   String
  // additional skills — correction 3 NORMALIZES these into WorkerSkill rows with a same-project
  // composite FK to LabourSkill, so a nonexistent/cross-project/subsequently-deleted skill is
  // unrepresentable AND concurrency-safe (no worker-insert vs skill-delete race). The DTO's
  // skillCodes[] is DERIVED from these rows.
  activeFrom  DateTime  @db.Date
  activeTo    DateTime? @db.Date
  revokedAt   DateTime?
  revokedBy   User?     @relation("workersRevoked", fields: [revokedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revokedById String?
  createdAt   DateTime  @default(now())
  createdBy   User      @relation("workersOnboarded", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById String

  devices         WorkerDevice[]
  crewMemberships CrewMembership[]
  ledBy           Crew[]           @relation("crewIncharge")
  skills          WorkerSkill[]
  // Phase 4 Task 3 — the §C time-capacity facts conserved at this worker (the atomic source)
  allocations     WorkerAllocation[]
  attendance      LabourAttendance[]
  workFacts       LabourWorkFact[]
  mismatches      LabourMismatch[]

  // composite identity for same-project (projectId, workerId) FKs (WorkerDevice, Crew, membership)
  @@unique([projectId, id])
  @@index([projectId, tradeCode])
}

// Correction 3 — the NORMALIZED worker-skill relation (replaces the denormalized Worker.skillCodes
// array + its two racing triggers). One row per (worker, skill), each FK-bound to BOTH the worker and
// the same-project LabourSkill catalog entry. The LabourSkill FK is onDelete/onUpdate NoAction, so a
// referenced skill cannot be deleted or re-keyed — enforced with real FK locking, which serializes a
// concurrent worker-insert vs skill-delete instead of letting both commit.
model WorkerSkill {
  projectId String
  workerId  String
  skillCode String
  worker    Worker      @relation(fields: [projectId, workerId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)
  skill     LabourSkill @relation(fields: [projectId, skillCode], references: [projectId, code], onDelete: NoAction, onUpdate: NoAction)

  @@id([projectId, workerId, skillCode])
  @@index([projectId, skillCode])
}

// A named set of workers under an in-charge (mistri) — ORGANIZATIONAL only, NOT an atomic
// capacity source (round-2 finding 1; the atomic source is the Worker).
model Crew {
  id               String    @id @default(cuid())
  project          Project   @relation(fields: [projectId], references: [id])
  projectId        String
  name             String
  // the in-charge (mistri) — a same-project worker (composite FK); optional
  incharge         Worker?   @relation("crewIncharge", fields: [projectId, inchargeWorkerId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  inchargeWorkerId String?
  activeFrom       DateTime  @db.Date
  activeTo         DateTime? @db.Date
  revokedAt        DateTime?
  revokedBy        User?     @relation("crewsRevoked", fields: [revokedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revokedById      String?
  createdAt        DateTime  @default(now())
  createdBy        User      @relation("crewsFormed", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById      String

  members CrewMembership[]

  @@unique([projectId, id])
}

// One worker's membership in a crew — project-contained (both composite FKs carry projectId, so
// a membership can NEVER cross-link a worker and crew from different projects). A member is
// removed by stamping removedAt (organizational history preserved). A partial-unique index (raw
// SQL) enforces at most one ACTIVE membership per (crew, worker).
model CrewMembership {
  id          String    @id @default(cuid())
  project     Project   @relation(fields: [projectId], references: [id])
  projectId   String
  crew        Crew      @relation(fields: [projectId, crewId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  crewId      String
  worker      Worker    @relation(fields: [projectId, workerId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  workerId    String
  addedAt     DateTime  @default(now())
  addedBy     User      @relation("crewMembersAdded", fields: [addedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  addedById   String
  removedAt   DateTime?
  removedBy   User?     @relation("crewMembersRemoved", fields: [removedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  removedById String?

  @@index([projectId, crewId])
  @@index([projectId, workerId])
}

// The LABOUR-ONLY specification detail of one requirement revision (§B) — the sibling of
// MaterialRequirementSpec. Labour-module-owned; written through LabourParticipant.writeRequirementSpec
// inside the Activities requirement command (the cycle-exempt participant channel, §G). The
// fingerprint hashes ONLY (tradeCode, skillCode, shift); decision provenance is stored, not
// hashed. Append-only via the shared BEFORE UPDATE OR DELETE trigger; a labour-aware DB
// type↔detail trigger enforces exactly-one detail per revision (material XOR labour). The demand
// is carried as explicit per-civilDate LabourDemandSlice rows (all sharing this spec's shift).
model LabourRequirementSpec {
  id            String              @id @default(cuid())
  project       Project             @relation(fields: [projectId], references: [id])
  projectId     String
  requirement   ActivityRequirement @relation(fields: [projectId, requirementId, revision], references: [projectId, requirementId, revision], onDelete: NoAction, onUpdate: NoAction)
  requirementId String
  revision      Int

  trade                 LabourTrade @relation(fields: [projectId, tradeCode], references: [projectId, code], onDelete: NoAction, onUpdate: NoAction)
  tradeCode             String
  // optional; a bare-trade demand. Task-1 correction F3 — a same-project composite FK makes a
  // nonexistent OR cross-project skill unrepresentable in PostgreSQL (was service-validated only).
  skill                 LabourSkill? @relation(fields: [projectId, skillCode], references: [projectId, code], onDelete: NoAction, onUpdate: NoAction)
  skillCode             String?
  shift                 String // 'day' | 'night' — part of the fingerprinted identity
  labourSpecFingerprint String

  // AUTHORITATIVE decision provenance — all null (manual) or all server-resolved (CHECK), FK-bound
  // onto the immutable DecisionApprovalRevision register (same rule as MaterialRequirementSpec).
  decision         Decision?                 @relation(fields: [projectId, decisionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  decisionId       String?
  approvalRevision DecisionApprovalRevision? @relation(fields: [projectId, decisionId, decisionVersion, optionKey], references: [projectId, decisionId, version, optionKey], onDelete: NoAction, onUpdate: NoAction)
  decisionVersion  Int?
  optionKey        String?

  @@unique([projectId, requirementId, revision])
  @@index([projectId, labourSpecFingerprint])
}

// One explicit (civilDate, shift, personShiftQty) demand slice of a labour requirement revision
// (§B, round-2 finding 2). shift is the parent spec's shift (joined for the DTO); personShiftQty
// is a positive integer count of person-shifts (a CHECK). A partial-unique (raw SQL) enforces one
// slice per (requirement, revision, civilDate). Append-only via the shared trigger; a raw-SQL
// trigger requires the revision to be labour-typed.
model LabourDemandSlice {
  id             String              @id @default(cuid())
  project        Project             @relation(fields: [projectId], references: [id])
  projectId      String
  requirement    ActivityRequirement @relation(fields: [projectId, requirementId, revision], references: [projectId, requirementId, revision], onDelete: NoAction, onUpdate: NoAction)
  requirementId  String
  revision       Int
  civilDate      DateTime @db.Date
  personShiftQty Int

  @@index([projectId, requirementId, revision])
}

// ══════════════════════════════════════════════════════════════════════════════════════════════
// Phase 4 Task 2 — the LABOUR COMMERCIAL chain (plan §F). The labour supplier IS the existing
// procurement-owned Vendor bound per project by ProjectVendor (F7 — NO LabourSupplier). These
// documents are SEPARATE from material (their lines carry per-(civilDate, shift) person-shift demand
// slices + a rate per person-shift), all labour-owned + project-contained, mirroring the material
// procurement CAS / frozen-snapshot / append-only / provenance discipline. References to EXISTING
// models (Project / User / Vendor / ProjectVendor / LabourRequirementSpec) are plain columns whose
// FKs are declared in raw SQL in the migration — so those owners stay untouched and Labour models
// no foreign relation; only intra-chain parent↔child links are Prisma relations (for nested reads).
// ══════════════════════════════════════════════════════════════════════════════════════════════

// A vendor's LABOUR capability profile (org-admin authority, like vendor CRUD). Org-scoped; the
// raw-SQL FK binds (orgId, vendorId) → Vendor(orgId, id). The trades/skills are the supplier's
// declared capabilities (free codes, not a project catalog reference).
model VendorLabourProfile {
  id          String   @id @default(cuid())
  orgId       String
  vendorId    String
  trades      String[]
  skills      String[]
  createdAt   DateTime @default(now())
  createdById String

  @@unique([orgId, vendorId])
  @@unique([orgId, id])
}

// The labour requisition — CAS draft→submitted→approved|rejected; approved→closed. Mirrors Requisition.
model LabourRequisition {
  id             String    @id @default(cuid())
  projectId      String
  title          String
  notes          String?
  status         String    @default("draft")
  createdAt      DateTime  @default(now())
  createdById    String
  submittedById  String?
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  closedAt       DateTime?

  lines LabourRequisitionLine[]
  rfqs  LabourRfq[]

  @@unique([projectId, id])
}

// One per-(requirementId, revision, civilDate) demand slice a labour requisition allocates. The
// spec's shift + fingerprint are frozen onto the line. Unit: person-shift. §F bound-1 allocation unit.
model LabourRequisitionLine {
  id                    String   @id @default(cuid())
  projectId             String
  requisition           LabourRequisition @relation(fields: [projectId, requisitionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  requisitionId         String
  // the labour requirement revision pin (composite raw-SQL FK to LabourRequirementSpec)
  requirementId         String
  revision              Int
  civilDate             DateTime @db.Date
  shift                 String
  labourSpecFingerprint String
  personShiftQty        Int
  status                String   @default("open") // open | ordered | cancelled
  cancelledAt           DateTime?
  cancelledById         String?

  quoteLines SupplierLabourQuoteLine[]
  poLines    LabourPurchaseOrderLine[]

  @@unique([projectId, id])
  @@unique([projectId, id, requirementId, revision])
  @@unique([projectId, requisitionId, id])
  @@index([projectId, requirementId, revision])
}

// The labour RFQ — issued→closed. Mirrors Rfq.
model LabourRfq {
  id            String    @id @default(cuid())
  projectId     String
  requisition   LabourRequisition @relation(fields: [projectId, requisitionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  requisitionId String
  status        String    @default("issued") // issued | closed
  issuedAt      DateTime  @default(now())
  issuedById    String
  closedAt      DateTime?

  quotes     SupplierLabourQuote[]
  comparison LabourQuoteComparison?

  @@unique([projectId, id])
  @@unique([projectId, id, requisitionId])
}

// A supplier's labour quote — recorded→superseded|expired. Mirrors VendorQuote. Bound to the vendor
// through ProjectVendor (raw-SQL composite FK) — same-project + same-org enforced.
model SupplierLabourQuote {
  id            String   @id @default(cuid())
  projectId     String
  rfq           LabourRfq @relation(fields: [projectId, rfqId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  rfqId         String
  requisitionId String   // denormalized + FK-sealed (containment)
  vendorId      String   // bound through ProjectVendor(projectId, vendorId), raw-SQL FK
  status        String   @default("recorded") // recorded | superseded | expired
  validUntil    DateTime @db.Date
  leadTimeDays  Int?
  notes         String?
  recordedAt    DateTime @default(now())
  recordedById  String

  lines SupplierLabourQuoteLine[]

  @@unique([projectId, id])
  @@unique([projectId, rfqId, vendorId, id])
  @@unique([projectId, id, requisitionId])
  @@index([projectId, rfqId, vendorId])
}

// A supplier labour quote LINE — the rate for ONE requisition line (one demand slice). Mirrors
// VendorQuoteLine. Rate/premium in INR paise-safe decimals; the person-shift qty comes from the line.
model SupplierLabourQuoteLine {
  id                String   @id @default(cuid())
  projectId         String
  quote             SupplierLabourQuote @relation(fields: [projectId, quoteId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  quoteId           String
  requisitionLine   LabourRequisitionLine @relation(fields: [projectId, requisitionLineId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  requisitionLineId String
  requisitionId     String  // containment, sealed both ways (raw-SQL FK)
  ratePerPersonShift Decimal @db.Decimal(18, 2)
  shiftPremium       Decimal @db.Decimal(18, 2)
  landedPerPersonShift Decimal @db.Decimal(18, 2)
  matchesSpecification Boolean

  @@unique([quoteId, requisitionLineId])
  @@unique([projectId, id])
}

// The labour quote comparison — draft→approved (sealed). Mirrors QuoteComparison. The selection is
// sealed to a same-rfq quote of the real vendor via a raw-SQL composite FK.
model LabourQuoteComparison {
  id               String    @id @default(cuid())
  projectId        String
  rfq              LabourRfq @relation(fields: [projectId, rfqId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  rfqId            String
  requisitionId    String
  status           String    @default("draft") // draft | approved
  selectedQuoteId  String?
  selectedVendorId String?
  reason           String?
  justification    String?
  createdAt        DateTime  @default(now())
  createdById      String
  approvedById     String?
  approvedAt       DateTime?

  @@unique([projectId, rfqId])
  @@unique([projectId, id])
  @@unique([projectId, id, selectedVendorId, requisitionId, status], map: "LabourQuoteComparison_provenance_status_key")
}

// The labour purchase order (immutable root). Mirrors PurchaseOrder. Provenance: the APPROVED
// comparison (status-pinned raw-SQL FK). Bound to the vendor through ProjectVendor.
model LabourPurchaseOrder {
  id               String   @id @default(cuid())
  projectId        String
  vendorId         String
  requisitionId    String
  comparisonId     String
  comparisonStatus String   @default("approved") // CHECK-pinned + part of the provenance FK
  createdAt        DateTime @default(now())
  createdById      String

  versions LabourPurchaseOrderVersion[]
  // Phase 5 Task 4 (§F) — the lines carrying this order's pinned identity
  pinnedLines LabourPurchaseOrderLine[]

  @@unique([projectId, id])
  @@unique([projectId, id, requisitionId])
  // Phase 5 Task 4 (§F vendor pinning) — the labour twin of the material FK target.
  @@unique([projectId, id, vendorId])
}

// A labour PO version — the frozen-identity CAS lifecycle. Mirrors PurchaseOrderVersion. An amendment
// issues a NEW version retaining the prior verbatim (supersedesVersion lineage).
model LabourPurchaseOrderVersion {
  id                String    @id @default(cuid())
  projectId         String
  po                LabourPurchaseOrder @relation(fields: [projectId, poId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  poId              String
  version           Int
  requisitionId     String
  comparisonId      String    // Task-2 correction F4: the approved comparison this version executes (frozen; DB-bound to the PO root)
  status            String    @default("draft") // draft|issued|partially_committed|completed|amended|cancelled|closed_short
  supersedesVersion Int?
  issuedById        String?
  issuedAt          DateTime?
  amendedAt         DateTime?
  amendReason       String?
  cancelledAt       DateTime?
  cancelReason      String?
  closedShortAt     DateTime?
  closeShortReason  String?
  createdAt         DateTime  @default(now())
  createdById       String

  lines LabourPurchaseOrderLine[]

  @@unique([poId, version])
  @@unique([projectId, id])
  @@unique([projectId, id, requisitionId])
  // Phase 5 Task 4 (§F vendor pinning) — the labour twin of the material FK target.
  @@unique([projectId, id, poId])
}

// A labour PO LINE — the FROZEN rate snapshot for ONE demand slice. Mirrors PurchaseOrderLine. The
// ONLY mutable column is committedQty (the person-shifts committed against this line, a progress fact).
model LabourPurchaseOrderLine {
  id                    String   @id @default(cuid())
  projectId             String
  poVersion             LabourPurchaseOrderVersion @relation(fields: [projectId, poVersionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  poVersionId           String
  requisitionLine       LabourRequisitionLine @relation(fields: [projectId, requisitionLineId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  requisitionLineId     String
  requisitionId         String
  requirementId         String
  revision              Int
  civilDate             DateTime @db.Date
  shift                 String
  labourSpecFingerprint String
  personShiftQty        Int
  ratePerPersonShift    Decimal  @db.Decimal(18, 2)
  shiftPremium          Decimal  @db.Decimal(18, 2)
  committedAmountBase   Decimal  @db.Decimal(18, 2)
  committedQty          Int      @default(0) // person-shifts committed (progress; the ONE mutable column)
  // Task-2 correction F4 — provenance: the comparison-selected quote line this line's rate/premium
  // came from (frozen; a composite-FK chain proves rate/premium == the selected quote line's).
  comparisonId          String
  selectedQuoteId       String
  selectedQuoteLineId   String

  // Phase 5 Task 4 (§F) — VENDOR PINNING, the labour twin. Same reasoning, same seals: the
  // vendor lives on the labour PO ROOT, so the line copies it (and its order) and both copies
  // are FK-sealed back to the version→root chain they came from.
  labourPurchaseOrder   LabourPurchaseOrder @relation(fields: [projectId, purchaseOrderId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  purchaseOrderId       String
  vendorId              String

  commitments CapacityCommitment[]
  // Phase 5 Task 1 (§C) — the commercial-owned cost-head attribution history for this line
  attributions CommitmentAttribution[]

  measurements Measurement[]
  // Phase 5 Task 4 (§F) — the vendor claim lines drawn against this order line
  billLines    VendorBillLine[]

  @@unique([projectId, id])
  // Phase 5 Task 4 (§F) — the FK target a labour bill line binds to.
  @@unique([projectId, id, vendorId])
  @@index([projectId, requisitionLineId])
}

// Inbound forecast capacity a source commits per (civilDate, shift) slice of a labourSpecFingerprint
// (§C.1). Unit: person-shift. One commitment per PO line (partial unique). committed→revised→defaulted.
model CapacityCommitment {
  id                    String   @id @default(cuid())
  projectId             String
  poLine                LabourPurchaseOrderLine @relation(fields: [projectId, poLineId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  poLineId              String
  labourSpecFingerprint String
  civilDate             DateTime @db.Date
  shift                 String
  personShiftQty        Int
  status                String   @default("committed") // committed | revised | defaulted
  createdAt             DateTime @default(now())
  createdById           String
  defaultedAt           DateTime?

  promises CapacityPromise[]
  // Phase 4 Task 3 — the named-worker allocations that draw this forecast capacity down (§F bound 3)
  allocations WorkerAllocation[]

  @@unique([projectId, id])
  // the candidate key the allocation's slice-identity FK references (§F bound 3): capacity
  // committed for one (fingerprint, civilDate, shift) can never be drawn for another
  @@unique([projectId, id, labourSpecFingerprint, civilDate, shift])
}

// A dated arrival/rate promise in the APPEND-ONLY register (§F). seq monotone; only the initial
// promise (seq 1) may omit the reason. Mirrors DeliveryPromise.
model CapacityPromise {
  id           String   @id @default(cuid())
  projectId    String
  commitment   CapacityCommitment @relation(fields: [projectId, commitmentId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  commitmentId String
  seq          Int
  promisedDate DateTime @db.Date
  reason       String?
  recordedAt   DateTime @default(now())
  recordedById String

  @@unique([commitmentId, seq])
  @@unique([projectId, id])
}

// ══════════════════════════════════════════════════════════════════════════════════════════════
// Phase 4 Task 3 — the §C TIME-CAPACITY fact families. Labour is EXPIRING capacity, so this is
// NOT a stock ledger: there is no current-quantity column and no bucket. It is three IMMUTABLE
// append-only observation families (attendance, work, substitution) + ONE frozen-identity CAS
// assignment (WorkerAllocation) — each with a DISTINCT unit — read together to derive coverage.
//
//   WorkerAllocation  1 person-shift  assignment  frozen identity, status active→released (CAS)
//   LabourAttendance  headcount (1)   observation append-only; one per worker/date/shift
//   LabourWorkFact    worked-minutes  observation append-only; Σ per slice ≤ shiftMinutes
//
// The ATOMIC capacity source is the Worker (round-2 finding 1): a Crew is organizational only, and
// allocating one EXPANDS transactionally into one WorkerAllocation per active member, so a worker
// double-booked directly, via two crews, or directly-and-via-crew all collide on the SAME
// per-worker partial-unique. Every Prisma-inexpressible seal (the partial uniques, the frozen
// identity + append-only triggers, the cumulative worked-minutes bound) lives in the raw-SQL
// migration, never in convention.
// ══════════════════════════════════════════════════════════════════════════════════════════════

// One Worker assigned for ONE (civilDate, shift) slice to ONE activity requirement revision.
// Unit: 1 person-shift. Identity is FROZEN by trigger (worker/date/shift/activity/requirement/
// originRevision/fingerprint); only `status` and the release attribution may change — the
// PurchaseOrderVersion frozen-identity CAS pattern, NOT append-only. Global conservation is the
// partial-unique on (projectId, workerId, civilDate, shift) WHERE status='active' (raw SQL).
model WorkerAllocation {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  // the atomic capacity source — a same-project worker (composite FK)
  worker    Worker  @relation(fields: [projectId, workerId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  workerId  String
  // the slice this person-shift is consumed by
  civilDate DateTime @db.Date
  shift     String   // 'day' | 'night'
  // the demand it satisfies — the activity target is validated through ActivityParticipant
  // (cycle-exempt); requirementId/originRevision/labourSpecFingerprint pin §B provenance so
  // coverage can carry a compatible revision forward (or strand an incompatible one).
  activityId            String
  requirementId         String
  originRevision        Int
  labourSpecFingerprint String
  // if the allocation came from a crew expansion, which crew (provenance only — capacity is
  // conserved per WORKER, never per crew)
  crewId    String?
  // §F bound 3 — the supplier capacity this allocation draws down, or NULL for own workforce
  // (an in-house worker needs no commitment). When set, a five-column composite FK binds the
  // allocation's (fingerprint, civilDate, shift) to the commitment's OWN slice, so capacity
  // committed for one slice can never be drawn for another; the bound
  // `active allocations ≤ commitment.personShiftQty` is re-derived under the commitment
  // `FOR UPDATE` in the allocating transaction.
  capacityCommitment   CapacityCommitment? @relation(fields: [projectId, capacityCommitmentId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  capacityCommitmentId String?
  status    String   @default("active") // active | released
  allocatedAt   DateTime @default(now())
  allocatedBy   User     @relation("allocationsMade", fields: [allocatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  allocatedById String
  releasedAt    DateTime?
  releasedBy    User?     @relation("allocationsReleased", fields: [releasedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  releasedById  String?
  releaseReason String?
  // §C rule ii — every fact records the command that produced it (project-contained composite FK)
  sourceCommandId String

  work LabourWorkFact[]

  @@unique([projectId, id])
  @@index([projectId, workerId, civilDate, shift])
  @@index([projectId, activityId, civilDate, shift])
  @@index([projectId, requirementId, originRevision])
}

// A PRESENCE observation — worker W was present on a (projectId, civilDate, shift) slice. A
// DISTINCT fact, never a transfer: attendance does not consume an allocation; coverage joins the
// two at read time. Unit: headcount (1 per worker). Append-only by trigger; a partial-unique on
// (projectId, workerId, civilDate, shift) WHERE revokedAt IS NULL gives one LIVE attendance per
// worker/date/shift (a revoked row survives as history and permits a corrected re-record).
model LabourAttendance {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  worker    Worker  @relation(fields: [projectId, workerId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  workerId  String
  civilDate DateTime @db.Date
  shift     String
  // Task-3 correction F2 — canonical presence carries TRUSTED evidence, because the Team gate reads
  // it as execution truth. EXACTLY ONE of the two below (a CHECK enforces it), so a bare presence
  // claim is unrepresentable: either the worker's OWN bound device evidenced the muster (the device
  // path; a device bound to another worker is rejected by the Task-3 trigger) …
  device    WorkerDevice? @relation(fields: [projectId, deviceId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  deviceId  String?
  // … or a pmc recorded an EXPLICIT, attributable exception saying why there is no device behind it.
  manualReason String?
  // the optional selfie/QR capture. Correction F2 adds the same-project composite FK (there was
  // none, so a nonexistent or cross-project id was accepted); while cited it cannot be deleted —
  // the labour participant refuses the media delete, since a muster is an append-only fact.
  evidenceMedia   Media? @relation("labourAttendanceEvidence", fields: [projectId, evidenceMediaId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  evidenceMediaId String?
  recordedAt   DateTime @default(now())
  recordedBy   User     @relation("attendanceRecorded", fields: [recordedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recordedById String
  // revocation is a CORRECTION, not a delete (the row survives; coverage re-derives without it)
  revokedAt    DateTime?
  revokedBy    User?     @relation("attendanceRevoked", fields: [revokedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revokedById  String?
  revokeReason String?
  sourceCommandId String

  @@unique([projectId, id])
  @@index([projectId, workerId, civilDate, shift])
  @@index([projectId, civilDate, shift])
}

// An EFFORT observation — worked-minutes against one allocation. A DISTINCT fact with a DISTINCT
// unit (worked-minutes), never a transfer of the presence headcount. Append-only by trigger;
// `workedMinutes` is bounded per row by a CHECK AND cumulatively by the command (round-3 guardrail
// 2: Σ workedMinutes for the (worker, civilDate, shift) slice is re-derived under the worker
// FOR UPDATE and must not exceed shiftMinutes — a per-row CHECK alone cannot stop rows summing past
// the shift). The measured construction OUTPUT is a separate Activities-owned fact (§I), not this.
model LabourWorkFact {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  worker    Worker  @relation(fields: [projectId, workerId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  workerId  String
  // the allocation this effort was performed under (same-project composite FK); its slice identity
  // is copied here and DB-bound to the allocation, so effort can never name a different slice.
  allocation   WorkerAllocation @relation(fields: [projectId, allocationId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  allocationId String
  activityId   String
  civilDate    DateTime @db.Date
  shift        String
  workedMinutes Int
  note          String?
  recordedAt   DateTime @default(now())
  recordedBy   User     @relation("labourWorkRecorded", fields: [recordedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recordedById String
  sourceCommandId String

  @@unique([projectId, id])
  @@index([projectId, workerId, civilDate, shift])
  @@index([projectId, activityId, civilDate, shift])
}

// The LABOUR analogue of ApprovedSubstitution (§B satisfaction rule): a pmc-authored, audited,
// revocable widening that admits capacity of `toFingerprint` as satisfying a requirement whose
// CURRENT HEAD fingerprint is `fromFingerprint` (the Phase-3 T6-F2 rule verbatim — binding to the
// head means a revision to an incompatible spec silently stops the substitution applying). A
// partial-unique on (projectId, requirementId, fromFingerprint, toFingerprint) WHERE revokedAt IS
// NULL forbids a second ACTIVE row while keeping revoked rows as history (raw SQL).
model ApprovedSkillSubstitution {
  id              String  @id @default(cuid())
  project         Project @relation(fields: [projectId], references: [id])
  projectId       String
  root            ActivityRequirementRoot @relation(fields: [projectId, requirementId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  requirementId   String
  fromFingerprint String
  toFingerprint   String
  reason          String
  approvedBy      User     @relation("skillSubstitutionsApproved", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedById    String
  at              DateTime @default(now())
  revokedAt       DateTime?
  revokedBy       User?     @relation("skillSubstitutionsRevoked", fields: [revokedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revokedById     String?
  revokeReason    String?
  sourceCommandId String

  @@unique([projectId, id])
  @@index([projectId, requirementId])
  @@index([projectId, toFingerprint])
}

// ── Phase 4 Task 5 — §E labour mismatch: the observation FACT + its append-only resolution ────
// register (the material `SiteMaterial.matched` + `MismatchResolution` discipline re-homed onto
// labour). A mismatch is an OBSERVATION (crew present ≠ crew allocated — wrong trade, or a
// shortfall recorded on site), never a stored flag: the derived Team gate reads UNRESOLVED rows
// directly (§A first-match `fail`). Resolution is pmc authority, append-only, UNIQUE per
// observation — the observation row is never edited. Both tables are labour-owned and sealed
// append-only in raw SQL (migration 20270305000000).
model LabourMismatch {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  // the activity whose Team gate this observation blocks (same-project composite FK)
  activity   Activity @relation(fields: [projectId, activityId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  activityId String
  civilDate  DateTime @db.Date
  shift      String
  kind       String // 'wrong_trade' | 'shortfall' (raw-SQL CHECK)
  // the observed worker (wrong-trade case); a shortfall observation names no worker
  worker   Worker? @relation(fields: [projectId, workerId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  workerId String?
  note     String
  recordedAt      DateTime @default(now())
  recordedBy      User     @relation("labourMismatchesRecorded", fields: [recordedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recordedById    String
  sourceCommandId String

  resolution LabourMismatchResolution?

  @@unique([projectId, id])
  @@index([projectId, activityId])
}

model LabourMismatchResolution {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  mismatch   LabourMismatch @relation(fields: [projectId, mismatchId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  mismatchId String
  resolution String // the disposition, e.g. 'reassigned-correct-trade'
  reason     String
  resolvedAt      DateTime @default(now())
  resolvedBy      User     @relation("labourMismatchesResolved", fields: [resolvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolvedById    String
  sourceCommandId String

  @@unique([projectId, mismatchId]) // ONE resolution per observation (§E)
  @@unique([projectId, id])
}

// ── Phase 4 Task 5 — §I the ACTIVITIES-owned measured-output fact. Immutable and
// evidence-bearing; the generic construction output any activity produces (quantity + UOM),
// NEVER the Daily-Log photo/progress counter and NEVER a labour row. Productivity = this
// quantity ÷ Labour's `LabourWorkFact` worked-minutes — a DERIVED read composed on the
// Activities side (Labour never reads this table), no stored column.
model ActivityWorkOutput {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  activity   Activity @relation(fields: [projectId, activityId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  activityId String
  civilDate  DateTime @db.Date
  shift      String
  quantity   Decimal  @db.Decimal(18, 6) // raw-SQL CHECK > 0
  uom        String
  evidence        Media?  @relation(fields: [projectId, evidenceMediaId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  evidenceMediaId String?
  note            String?
  recordedAt      DateTime @default(now())
  recordedBy      User     @relation("activityOutputsRecorded", fields: [recordedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recordedById    String
  sourceCommandId String

  measurements Measurement[]

  @@unique([projectId, id])
  /// Codex round-4 P2 — the candidate key a `Measurement` binds its cited output to, so the
  /// output PostgreSQL admits as evidence is one recorded against the measurement's OWN activity.
  /// Unique because `(projectId, id)` already is; widening it adds a target, never a constraint.
  @@unique([projectId, id, activityId])
  @@index([projectId, activityId, civilDate, shift])
}

// ─── Phase 5 Task 1 — the COMMERCIAL module (plan §C/§K/§L) ────────────────────────────────
// `commercial` is a SINK: it reads procurement/inventory/labour/activities and NOTHING reads
// it. Task 1 ships the cost-head catalog and the commitment attribution — the ONLY new fact
// §C admits — plus its PostgreSQL seals. The versioned budget and the `COMMITTED` fold that
// reads these rows land in Task 2 (§L: authority is only meaningful against the obligation it
// measures, so BUDGET and its exception ship together).

model CostHead {
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  code        String // §0b "a key that groups facts is FROZEN after write" — a column-freeze trigger
  name        String
  definedAt   DateTime @default(now())
  definedBy   User     @relation("costHeadsDefined", fields: [definedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  definedById String

  attributions     CommitmentAttribution[]
  budgetLines      BudgetLine[]
  budgetExceptions BudgetException[]

  // Project-contained identity, the `LabourTrade` convention: the code IS the key inside a project.
  @@id([projectId, code])
}

// §C — the attribution is the ONLY new fact; the amount is NOT copied, so there is deliberately
// NO amount column (a column to copy it into is how the rule gets broken). `COMMITTED` reads the
// frozen amount from the PO-line snapshot through the OWNING module's query: `ProcurementQuery`
// for a `PurchaseOrderLine`, `LabourQuery` for a `LabourPurchaseOrderLine` — one fold, two owners.
//
// Append-only at PostgreSQL: DELETE is refused always, and UPDATE is refused always EXCEPT the ONE
// controlled transition — stamping an ACTIVE row superseded (`supersededAt`/`supersededById`/
// `supersedeReason` and nothing else). The identity columns, `costHeadCode` and `reason` are
// rejected on any UPDATE, and a row already superseded cannot be stamped again. Reclassification
// therefore has exactly one representable path and always leaves TWO rows.
model CommitmentAttribution {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  // EXACTLY ONE target — enforced by a raw-SQL XOR CHECK
  // (`("poLineId" IS NULL) <> ("labourPoLineId" IS NULL)`). Both degenerate shapes are real
  // defects: BOTH targets makes one row stand for two obligations (superseding the material side
  // silently un-attributes a live labour line); NEITHER lets issuance satisfy the
  // never-unattributed partial unique with a fact that attributes nothing.
  poLine         PurchaseOrderLine?       @relation(fields: [projectId, poLineId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  poLineId       String?
  labourPoLine   LabourPurchaseOrderLine? @relation(fields: [projectId, labourPoLineId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  labourPoLineId String?

  costHead     CostHead @relation(fields: [projectId, costHeadCode], references: [projectId, code], onDelete: NoAction, onUpdate: NoAction)
  costHeadCode String
  reason       String // non-blank CHECK; frozen after write (§0b)

  createdAt   DateTime @default(now())
  createdBy   User     @relation("attributionsCreated", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById String

  // The single permitted transition. A row with `supersededAt IS NULL` is ACTIVE.
  supersededAt    DateTime?
  supersededBy    User?     @relation("attributionsSuperseded", fields: [supersededById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersededById  String?
  supersedeReason String?

  @@unique([projectId, id])
  @@index([projectId, costHeadCode])
  // The two PARTIAL uniques — one per TARGET, not per row — live in the migration
  // (Prisma cannot express a partial index):
  //   (projectId, poLineId)       WHERE "supersededAt" IS NULL AND "poLineId"       IS NOT NULL
  //   (projectId, labourPoLineId) WHERE "supersededAt" IS NULL AND "labourPoLineId" IS NOT NULL
}

// Phase 5 Task 2 (§B) — the BUDGET, versioned and immutable.
//
// A budget line is a project-scoped PLAN with an amount and a scope key, and the scope key is
// `(projectId, costHead)` — NOT the activity id and NOT the location node. Binding budget to an
// activity would make a schedule edit a budget edit; the two must move independently.
//
// Versioned and immutable (spec §97): a revision APPENDS a new version retaining the prior
// verbatim, with an attributable reason. There is no in-place edit — the same discipline, and the
// same trigger shape, as `CommitmentAttribution`.
//
// `BUDGET(costHead)` is defined (§0) as "the amount of the LIVE budget version only", which
// presupposes there is exactly ONE: two live roots for one head would overstate the plan when
// summed and hide an approved plan when one is picked. A partial unique on the live row and a
// `amount >= 0` CHECK make both unrepresentable rather than merely unvalidated.
//
// A budget line does NOT gate anything. Exceeding it produces a flagged exception and an Inbox
// action; it never blocks a PO, because stopping site supply over a planning number is the wrong
// failure mode.
model BudgetLine {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  costHead     CostHead @relation(fields: [projectId, costHeadCode], references: [projectId, code], onDelete: NoAction, onUpdate: NoAction)
  costHeadCode String
  amount       Decimal  @db.Decimal(18, 2) // raw-SQL CHECK >= 0
  version      Int // monotonic within the head; v1 is the first plan
  reason       String // non-blank CHECK; frozen after write

  createdAt   DateTime @default(now())
  createdBy   User     @relation("budgetLinesAuthored", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById String

  // The single permitted transition. A row with `supersededAt IS NULL` is the LIVE version.
  supersededAt    DateTime?
  supersededBy    User?     @relation("budgetLinesSuperseded", fields: [supersededById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersededById  String?
  supersedeReason String?

  @@unique([projectId, id])
  @@unique([projectId, costHeadCode, version]) // versions are monotonic and never reused
  @@index([projectId, costHeadCode])
  // The PARTIAL unique — exactly one LIVE version per head — lives in the migration
  // (Prisma cannot express a partial index):
  //   (projectId, costHeadCode) WHERE "supersededAt" IS NULL
}

// Phase 5 Task 2 (§B) — the over-budget EXCEPTION.
//
// A budget line does not gate anything: exceeding it produces a flagged exception and an Inbox
// action, never a refused PO, because stopping site supply over a planning number is the wrong
// failure mode.
//
// The exception has a LIFECYCLE, which is why it is a row and not a derived read. §B requires
// every write that can move headroom to "raise or clear the exception in the same transaction",
// and a flat notification cannot be cleared. Headroom is `BUDGET − Σ exposure`, so THREE
// different writes can turn it negative: a new or amended commitment (exposure up), a budget
// revision downward (authority down), and a re-attribution that moves an obligation onto a head
// that cannot absorb it. An earlier plan revision named only the commitment, which leaves the
// most ordinary case silent — a ₹100 budget with a ₹90 PO revised down to ₹50 produces −₹40 of
// headroom with no commitment write anywhere.
//
// The row records the headroom AT THE MOMENT IT WAS RAISED, so the Inbox action is answerable
// later even after the numbers move; the fold stays the live truth.
/// Phase 5 Task 3 (§D) — a MEASUREMENT: a contractually agreed quantity at a contract rate, taken
/// by a named person on a named date, against a named PO line. It is NOT `ActivityWorkOutput`
/// (what was physically produced) and NOT `LabourWorkFact` (minutes worked): different unit,
/// different authority, different lifecycle.
///
/// IMMUTABLE once taken. A correction is a NEW row carrying a SIGNED delta and a reason, so
/// `MEASURED(poLine)` is a fold with no stored balance — the Phase-3 §C rule.
///
/// LABOUR ONLY. §D: material lines are not measured, because `ACCEPTED(poLine)` already IS the
/// measurement of a delivery, and a parallel manual figure would be a second truth about one
/// physical event. There is deliberately no `poLineId` column here — a material measurement is
/// unrepresentable rather than merely refused.
model Measurement {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  /// the LABOUR PO line this quantity is measured against (same-project composite FK)
  labourPoLine   LabourPurchaseOrderLine @relation(fields: [projectId, labourPoLineId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  labourPoLineId String

  /// the activity whose signed-off work this measures — validated through ActivityParticipant
  /// under the activity row lock (§D: never a plain status query)
  activity   Activity @relation(fields: [projectId, activityId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  activityId String

  /// person-shifts. SIGNED: a correction is a negative row. The FOLD is bounded (never negative,
  /// never above EFFORT, never above the ordered authority) — a per-row CHECK cannot say that, so
  /// the only per-row rule is that a row must move something.
  quantity Decimal @db.Decimal(18, 6) // raw-SQL CHECK <> 0

  /// the correction this row adjusts, or NULL for an original measurement. Present so a reducing
  /// correction can be attributed to the row it walks back, which §E's consumption freeze needs.
  ///
  /// Codex round-4 P2 — the FK carries the target's WHOLE WORK IDENTITY, not merely its existence.
  /// Proving only that the target row exists let a correction name original A while its own
  /// `labourPoLineId`/`activityId`/`citedOutputId` described B's work: the fold would apply the
  /// signed quantity to B while `netOf(A)` counted it as A's child, so the immutable register could
  /// add or withdraw payable evidence for a different line than the correction says it adjusts.
  corrects   Measurement? @relation("measurementCorrections", fields: [projectId, correctsId, labourPoLineId, activityId, citedOutputId], references: [projectId, id, labourPoLineId, activityId, citedOutputId], onDelete: NoAction, onUpdate: NoAction)
  correctsId String?
  corrections Measurement[] @relation("measurementCorrections")

  /// non-blank CHECK; required on a correction (a signed delta with no reason is unauditable)
  reason String?

  measuredOn DateTime @db.Date
  /// progress EVIDENCE (§0 `OUTPUT` is a predicate, not a pool) — the cited activity work output
  /// Codex round-4 P2 — the FK binds the output to THIS measurement's activity. Project
  /// containment alone let a maintenance insert or a future writer store `activityId = A` while
  /// citing an output recorded against B, and because the row is immutable, sign-off withdrawal
  /// and later billing would treat B's progress as evidence for A forever.
  citedOutput   ActivityWorkOutput @relation(fields: [projectId, citedOutputId, activityId], references: [projectId, id, activityId], onDelete: NoAction, onUpdate: NoAction)
  citedOutputId String

  evidence        Media?  @relation(fields: [projectId, evidenceMediaId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  evidenceMediaId String?

  takenAt   DateTime @default(now())
  takenBy   User     @relation("measurementsTaken", fields: [takenById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  takenById String

  /// §C rule ii — every fact records the command that produced it
  sourceCommandId String

  @@unique([projectId, id])
  /// Codex round-4 P2 — the candidate key a CORRECTION binds to, so a correction and the row it
  /// adjusts necessarily describe the same work. Unique because `(projectId, id)` already is.
  @@unique([projectId, id, labourPoLineId, activityId, citedOutputId])
  @@index([projectId, labourPoLineId])
  @@index([projectId, activityId])
}

model BudgetException {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  costHead     CostHead @relation(fields: [projectId, costHeadCode], references: [projectId, code], onDelete: NoAction, onUpdate: NoAction)
  costHeadCode String

  /// the headroom that triggered this exception — negative by construction (raw-SQL CHECK < 0)
  headroom Decimal @db.Decimal(18, 2)
  /// BUDGET and exposure as they stood, so the row explains itself without re-folding history
  budget   Decimal @db.Decimal(18, 2)
  exposure Decimal @db.Decimal(18, 2)
  /// which write raised it: 'commitment' | 'budget_revision' | 'reattribution' (CHECK)
  raisedBy String

  raisedAt   DateTime @default(now())
  raisedBy_  User     @relation("budgetExceptionsRaised", fields: [raisedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  raisedById String

  /// cleared when a later write returns headroom to non-negative — the ONE permitted transition
  clearedAt DateTime?

  @@unique([projectId, id])
  @@index([projectId, costHeadCode])
  // Exactly one OPEN exception per head — a partial unique in the migration, so a second
  // headroom-moving write on an already-excepted head does not stack duplicate Inbox actions:
  //   (projectId, costHeadCode) WHERE "clearedAt" IS NULL
}

// ─── Phase 5 Task 4 (§F/§G) — the VENDOR BILL: the vendor's CLAIM ────────────────────────────
//
// A bill is what the counterparty says it is owed. It is NOT a payable: §G bounds it against
// operational evidence (bound 1 — ordered authority; bound 2 — what actually arrived or was
// measured), and only Task 5's three-way verification and certification can make money payable.
//
// The split across three tables follows §F literally:
//   • `VendorBill`        the IDENTITY and the current lifecycle state — the duplicate-claim key
//                         `(projectId, vendorId, vendorBillNumber)` lives here, frozen after write
//   • `VendorBillVersion` an IMMUTABLE claim version; an amendment issues a NEW one retaining the
//                         prior verbatim with `supersedesVersion` lineage, exactly like a PO
//   • `VendorBillLine`    one immutable claim line, bound to EXACTLY ONE PO line whose vendor is
//                         PG-proven to be this bill's vendor
//
// The status lives on the ROOT rather than the version because the duplicate-document index is a
// predicate on the lifecycle's own terminal release states (§F, probe 5bj), and a partial unique
// can only read columns of the row it indexes.
/// §F/§I — the claim's COMMERCIAL REVISION: a counter that only ever moves forward, advanced
/// whenever anything a reviewer would have seen changes — every §F status transition and every
/// write to the six tables feeding `NET_PAYABLE`, `APPROVED` and `PAID`.
///
/// ITS OWN ROW, not a column on `VendorBill`, and that is the design rather than a detail. A
/// trigger advancing a column would take the CLAIM'S row lock from writers holding no other lock,
/// and Task 5C's Codex round 6 removed a certificate-side bill lock for exactly that reason: the
/// honest withholding path runs `bill → certificate`, so a certificate-side write reaching back
/// for the bill is ABBA, and PostgreSQL answers an ABBA cycle with a deadlock abort rather than
/// the refusal the seal was written to give. On its own row the counter is taken LAST by everyone
/// and forms a cycle with nothing.
///
/// The row is created WITH the bill (a trigger on `VendorBill` insert) and can never be deleted,
/// so every reader locks a row that exists rather than falling back to an implicit zero that
/// nothing holds still.
model VendorBillRevision {
  projectId String
  billId    String
  bill      VendorBill @relation(fields: [projectId, billId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  revision  Int        @default(0)

  @@id([projectId, billId])
}

model VendorBill {
  revisionRow  VendorBillRevision?
  certificates BillCertificate[]
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  /// the counterparty, bound to this project. A LINE's PO line is FK-proven to carry the SAME
  /// vendor, so Vendor A claiming against Vendor B's order is unrepresentable (§F).
  binding  ProjectVendor @relation(fields: [projectId, vendorId], references: [projectId, vendorId], onDelete: NoAction, onUpdate: NoAction)
  vendorId String

  /// §0b "a key that groups facts is FROZEN after write" — probe 5bg makes this the
  /// duplicate-claim key, so an editable number would let a vendor re-submit the same claim under
  /// a new number after the first is verified and duplicate detection would stop resting on
  /// immutable vendor evidence. Non-blank CHECK + column-freeze trigger, both.
  vendorBillNumber String
  /// the vendor's own document date. Frozen with the number: the two together are the claim's
  /// identity, and a movable date re-dates a claim after it has been checked.
  documentDate     DateTime @db.Date

  /// §F. draft → submitted → under-verification → { verified | disputed }; disputed → resolved;
  /// every uncertified live state → disputed; draft|submitted|under-verification|disputed|
  /// verified → rejected. Task 4 ships the lifecycle UP TO `under-verification` plus `disputed`,
  /// `resolved` and `rejected`. `verified` and everything past it belong to the task that
  /// produces their evidence (§E, Task 5) — a control ships with the transition it guards.
  status         String    @default("draft")
  statusChangedAt DateTime @default(now())
  /// why the claim left the live set — required on `rejected` and on `disputed` (non-blank CHECK)
  statusReason   String?
  /// §F — the version that was live when this claim was DISPUTED, captured by the lifecycle
  /// trigger and overwritten on every update, so no writer can supply it. `disputed → resolved`
  /// requires a live version superseding exactly this one: a resolution releases the
  /// duplicate-document key, so one with no correction behind it would free the vendor's number
  /// for a claim nobody fixed.
  disputedAtVersion Int?
  /// §F — WHY it was disputed, captured by the same trigger and equally unwritable. `statusReason`
  /// explains the CURRENT status, so a later `disputed → rejected` writes its own judgement over it;
  /// the breach that first took the claim out of the live fold is evidence and survives here.
  disputeReason     String?

  createdAt   DateTime @default(now())
  createdBy   User     @relation("vendorBillsCreated", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById String

  /// §C rule ii — every fact records the command that produced it
  sourceCommandId String

  versions      VendorBillVersion[]
  verifications BillVerification[]

  @@unique([projectId, id])
  /// the FK target proving a VERSION belongs to a bill of this vendor, and a LINE in turn
  @@unique([projectId, id, vendorId])
  @@index([projectId, vendorId])
  // The DUPLICATE-DOCUMENT partial unique lives in the migration (Prisma cannot express one):
  //   (projectId, vendorId, vendorBillNumber) WHERE "status" NOT IN ('rejected','resolved')
  // It releases on the LIFECYCLE'S OWN terminal states and on nothing else (§F, probe 5bj): a
  // predicate naming a state §F does not define would never release at all.
  paymentApprovals PaymentApproval[]
  payments Payment[]
  paymentReversals PaymentReversal[]
}

/// §F — an IMMUTABLE claim version. Amending issues a NEW version and supersedes this one; §0's
/// LIVE rule then drops the retained version from every billed set, so v1 100 → v2 100 folds to
/// 100 and not 200 (probe 5d). Append-only at PostgreSQL except the ONE supersession stamp.
model VendorBillVersion {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  bill   VendorBill @relation(fields: [projectId, billId, vendorIdPin], references: [projectId, id, vendorId], onDelete: NoAction, onUpdate: NoAction)
  billId String
  /// the bill's vendor, denormalized and FK-sealed to the root above, so a LINE can be
  /// vendor-sealed in turn without a transitive join PostgreSQL cannot express
  vendorIdPin String
  /// monotonic within the bill; v1 is the first claim
  version Int
  /// the amended prior version this reissue replaces — the PO's `supersedesVersion` lineage
  supersedesVersion Int?

  /// the claim total, DERIVED from the lines and re-derived by a deferred constraint trigger, so
  /// a version's stated money can never disagree with the lines `BILLED_AMOUNT` actually folds
  claimedAmount Decimal @db.Decimal(18, 2)
  /// how many claim lines this version was RECORDED with, frozen and re-derived by the same
  /// deferred check (Codex round-1 F4). The money check alone does not close the line set: a
  /// ZERO-money line leaves `claimedAmount` exactly equal to the line total while adding QUANTITY
  /// to `BILLED_QTY`. A COUNT rather than a quantity, because one version can carry base units and
  /// person-shifts at once and those do not sum to anything.
  lineCount     Int

  createdAt   DateTime @default(now())
  createdBy   User     @relation("vendorBillVersionsCreated", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById String

  /// the ONE permitted transition. A row with `supersededAt IS NULL` is the CURRENT version.
  supersededAt    DateTime?
  supersededBy    User?     @relation("vendorBillVersionsSuperseded", fields: [supersededById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersededById  String?
  supersedeReason String?

  lines     VendorBillLine[]
  sodGrants SodGrant[]

  @@unique([projectId, id])
  @@unique([projectId, billId, version]) // versions are monotonic and never reused
  /// the FK target proving a certificate — and a §I grant — names a version OF THE BILL IT IS
  /// ABOUT. Created in unit A's migration; declared here so Prisma can express the relation.
  @@unique([projectId, id, billId])
  /// the FK target sealing every LINE to its version's own bill and vendor
  @@unique([projectId, id, billId, vendorIdPin])
  @@index([projectId, billId])
  // The partial unique — exactly one CURRENT version per bill — lives in the migration:
  //   (projectId, billId) WHERE "supersededAt" IS NULL
}

/// §F — ONE immutable claim line, naming EXACTLY ONE PO line.
///
/// A material claim points at a `PurchaseOrderLine` and a labour claim at a
/// `LabourPurchaseOrderLine`, which means two nullable reference columns — and an FK on each
/// constrains only the reference that is PRESENT. Both degenerate shapes defeat §G: a line with
/// NEITHER carries money into `BILLED_AMOUNT` and certifies while bounds 1–2 never run (they are
/// folds over a PO line and there is no PO line to fold against); a line with BOTH leaves the
/// fold owner ambiguous, so the same money draws down two ordered quantities or, depending on
/// which side a fold reads, neither. Hence the XOR CHECK plus a `type` discriminator that must
/// AGREE with whichever reference is present — the same type↔detail correspondence Phase 4
/// Task 1 sealed for `ActivityRequirement`.
model VendorBillLine {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  version   VendorBillVersion @relation(fields: [projectId, versionId, billId, vendorId], references: [projectId, id, billId, vendorIdPin], onDelete: NoAction, onUpdate: NoAction)
  versionId String
  /// denormalized so the line's vendor can be sealed to BOTH its bill and its PO line
  billId    String
  vendorId  String

  /// 'material' | 'labour' — CHECK-bound to agree with the reference present
  type String

  poLine         PurchaseOrderLine?       @relation(fields: [projectId, poLineId, vendorId], references: [projectId, id, vendorId], onDelete: NoAction, onUpdate: NoAction)
  poLineId       String?
  labourPoLine   LabourPurchaseOrderLine? @relation(fields: [projectId, labourPoLineId, vendorId], references: [projectId, id, vendorId], onDelete: NoAction, onUpdate: NoAction)
  labourPoLineId String?

  /// the claimed quantity in the PO line's own unit — base units for material, person-shifts for
  /// labour. STRICTLY POSITIVE (§0b): a credit is a separate document with its own semantics, not
  /// a negative line inside a conservation fold, and Phase 5 has no credit note. A live −100-unit
  /// claim beside a 200-unit bill would leave cumulative `BILLED_QTY` at 100 and pass bounds 1–2
  /// against 100 accepted while the second bill certifies against its own bill-scoped amount.
  quantity Decimal @db.Decimal(18, 6)
  /// the claimed per-base-unit rate. §E compares it to the frozen ordered rate in Task 5; here it
  /// is the money the claim is made of.
  rate     Decimal @db.Decimal(18, 2)
  /// NON-NEGATIVE, not strictly positive (§0b): `PurchaseOrderLine`'s own CHECK is
  /// `taxAmount >= 0 AND freightAmount >= 0`, so a zero-tax / zero-freight PO is legitimate and a
  /// strictly-positive claim check would refuse a bill that matches the ordered evidence EXACTLY.
  /// A LABOUR line's two are CHECK-pinned to zero: the `LabourPurchaseOrderLine` snapshot freezes
  /// no ordered tax or freight, so there is nothing to verify such a claim against (probe 5au).
  taxAmount     Decimal @db.Decimal(18, 2)
  freightAmount Decimal @db.Decimal(18, 2)
  /// DERIVED = round(rate × quantity, 2) + tax + freight, re-derived by a DB CHECK so the money a
  /// fold reads is always the money the line's own components make (§A: half-up at 2 decimals,
  /// applied only where a value is persisted)
  amount        Decimal @db.Decimal(18, 2)

  @@unique([projectId, id])
  @@index([projectId, versionId])
  @@index([projectId, poLineId])
  @@index([projectId, labourPoLineId])
  // The XOR CHECK, the type↔reference correspondence, the sign CHECKs, the labour tax/freight
  // pin and the derived-amount CHECK all live in the migration.
}

/// Phase 5 Task 5A (§E) — the VERDICT, recorded.
///
/// §E says the triple is "derived, never stored", and this does not store it: the triple is still
/// recomputed at every transition that depends on it. What this records is that a verification
/// HAPPENED, by whom, over which claim version, and what it concluded — which is a different fact
/// from the triple itself, and one the system needs for two reasons a derivation cannot serve:
///
///  1. `verified` must be the SHADOW OF A FACT, not a status a writer may assert. Without this row
///     the database has no way to tell a verified claim from one somebody marked verified, and a
///     2× over-rate claim can be walked straight past the §E check by direct SQL.
///  2. An idempotency REPLAY must return what the original call concluded. Recomputing after the
///     first call already disputed the bill folds WITHOUT it — §0 excludes a disputed claim — so a
///     retry would answer `matched` and contradict the dispute that actually happened.
///
/// Append-only: it is the evidence behind a status, and a rewritable verdict is no verdict.
model BillVerification {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  bill   VendorBill @relation(fields: [projectId, billId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  billId String
  /// the claim version verified. An amendment supersedes it, so a verdict cannot outlive the claim
  /// it was computed over — which is what makes the trigger's check meaningful.
  versionId String

  /// `matched` | `exception`
  verdict String
  /// the §E exception kinds, empty on a match. Stored as the durable evidence a replay returns.
  exceptions String[]

  verifiedAt   DateTime @default(now())
  verifiedBy   User     @relation("billVerificationsVerified", fields: [verifiedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verifiedById String

  /// the `commercial.bill.verify` execution that PRODUCED this verdict. The composite FK to
  /// `CommandExecution(projectId, id)` and the `resultRef` back-reference are raw SQL — see
  /// `VendorBill_verified_provenance`, the deferred half of the seal.
  sourceCommandId String

  @@unique([projectId, id])
  /// one command produces at most one verdict — a second row citing a spent command is the reuse
  /// the provenance seal exists to refuse
  @@unique([projectId, sourceCommandId])
  @@index([projectId, billId])
  @@index([projectId, versionId])
}

/// Phase 5 Task 5 (§E/§F) — the CERTIFICATE: the act that turns a verified claim into money
/// anyone may approve. It is a FACT, not a status: append-only, attributable, and superseded by a
/// new certificate rather than edited (§F — "past certification the correction path is a
/// superseding certificate").
///
/// `certifiedAmount` is FROZEN. §G bound 3 caps it at `BILLED_AMOUNT(bill)`, and bound 4 caps the
/// approvals that hang off it at `NET_PAYABLE` = this amount less unreleased deductions.
model BillCertificate {
  /// §I — the claim's commercial revision at the moment this act was performed, so the consume
  /// seal can require an authority and the act it excuses to name the SAME passage of the claim.
  /// By COMMIT the act has already advanced the counter, so what the seal compares has to be a
  /// fact each row carries rather than one it infers. NULLABLE for rows written before it existed.
  reviewedLifecycleVersion Int?

  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  bill      VendorBill @relation(fields: [projectId, billId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  billId    String
  /// the claim version this certificate was computed against. A later amendment supersedes the
  /// version, and §0's LIVE rule then drops it from every billed fold — so a certificate that did
  /// not name its version could outlive the claim it certified.
  versionId String

  /// FROZEN money (§A `Decimal(18,2)`, half-up, never float64)
  certifiedAmount Decimal @db.Decimal(18, 2)

  /// the ONE permitted transition: a superseding certificate retains this one verbatim as history.
  /// §G bounds 3–5 read the LIVE certificate only — summing a superseded one reads a corrected
  /// ₹100 certification as ₹200.
  supersededAt    DateTime?
  supersededById  String?
  supersedeReason String?

  certifiedAt   DateTime @default(now())
  certifiedBy   User     @relation("billCertificatesCertified", fields: [certifiedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  certifiedById String

  /// §C rule ii — every fact records the command that produced it
  sourceCommandId String

  acceptanceConsumption  CertifiedAcceptanceConsumption[]
  measurementConsumption CertifiedMeasurementConsumption[]
  sodExceptions          SodException[]
  sodGrantsConsumed      SodGrant[]
  deductions             BillDeduction[]
  approvals              PaymentApproval[]
  // The one-LIVE-certificate-per-bill partial unique and the append-only trigger live in the
  // migration (Prisma cannot express a partial unique).

  @@unique([projectId, id])
  /// the FK target proving a consumption row, a deduction and an SoD exception belong to a
  /// certificate OF THIS BILL
  @@unique([projectId, id, billId])
  @@index([projectId, billId])
}

/// §E — WHICH acceptance rows this certificate consumed AND HOW MUCH OF EACH.
///
/// Row identity alone is too coarse and the aggregate is too weak: one 100-unit acceptance with an
/// 80-unit certificate needs `(rowId, consumedQty)` so the unused 20 stays reversible while the
/// consumed 80 does not. Append-only — the evidence a payable fact rests on cannot be restated.
model CertifiedAcceptanceConsumption {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  certificate   BillCertificate @relation(fields: [projectId, certificateId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  certificateId String

  /// the `acceptance` StockTransaction row this certificate drew on
  stockTransactionId String
  consumedQty        Decimal @db.Decimal(18, 6)

  @@unique([projectId, id])
  /// one consumption row per (certificate, acceptance row) — a second would double-count
  @@unique([projectId, certificateId, stockTransactionId])
  @@index([projectId, stockTransactionId])
}

/// §E/§D — the LABOUR twin: which `Measurement` rows this certificate consumed, and how much of
/// each. Same rule, both sides (§0b).
model CertifiedMeasurementConsumption {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  certificate   BillCertificate @relation(fields: [projectId, certificateId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  certificateId String

  measurementId String
  consumedQty   Decimal @db.Decimal(18, 6)

  @@unique([projectId, id])
  @@unique([projectId, certificateId, measurementId])
  @@index([projectId, measurementId])
}

/// §I — the attributable record that makes an otherwise-forbidden act valid.
///
/// It IS the authority, so it carries the trusted-evidence seals: append-only at PG, every column
/// immutable after write, a non-blank reason, written in the SAME transaction as the override it
/// authorizes, and bound BY COMPOSITE FK to the exact fact it authorizes — an exception is
/// authority for ONE certificate, never a standing waiver a later override can point at.
model SodException {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  /// the certificate this exception authorizes. Task 6 adds the approval-side rule and its own
  /// nullable reference; a row names exactly one fact (CHECK).
  certificate   BillCertificate? @relation(fields: [projectId, certificateId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  certificateId String?

  /// the APPROVAL this exception authorizes (Task 6A, the payment half of §I). A row names
  /// exactly ONE fact — a certificate OR an approval — because an exception is authority for one
  /// act, never a standing waiver a later override can point at (CHECK in the migration).
  approval   PaymentApproval? @relation(fields: [projectId, approvalId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  approvalId String?

  /// the GRANT this override rests on — the approver's own authenticated act (Codex round-7 P1).
  /// Without it `approverId` is only a name the certifier typed into their own request.
  grant   SodGrant? @relation(fields: [projectId, grantId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  grantId String?

  /// which rule was overridden, e.g. `measurer-may-not-certify`
  rule       String
  /// the actor the rule would have refused
  actor      User   @relation("sodExceptionsActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorId    String
  /// the STRONGER authority that authorized it (org admin)
  approver   User   @relation("sodExceptionsApprover", fields: [approverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approverId String
  reason     String

  recordedAt      DateTime @default(now())
  sourceCommandId String

  @@unique([projectId, id])
  @@index([projectId, certificateId])
}

/// §I — a stronger authority's OWN act, authorising ONE otherwise-forbidden certification.
///
/// The exception records that an override happened; this records that somebody with standing
/// actually granted it. Splitting them is the point: `SodException` is written by the certifier's
/// command, so on its own it can only ever be the certifier's claim about a third party. A grant is
/// written by the APPROVER's authenticated command, scoped to one bill, one claim version, one rule
/// and one actor, and consumed exactly once.
model SodGrant {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  /// the claim this authority is about, pinned to the VERSION — an amendment is a different claim,
  /// and permission to certify this one should not survive it
  version   VendorBillVersion @relation(fields: [projectId, versionId, billId], references: [projectId, id, billId], onDelete: NoAction, onUpdate: NoAction)
  versionId String
  billId    String

  rule       String
  /// the actor the rule would refuse — who this grant excuses
  actor      User   @relation("sodGrantsActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorId    String
  /// the stronger authority, and the AUTHENTICATED author of this row
  approver   User   @relation("sodGrantsApprover", fields: [approverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approverId String
  reason     String

  /// §I — the claim STATUS the approver had in front of them when they authorised.
  ///
  /// Phase 5 Task 7B-iii-h. The version alone does not identify what was reviewed: one version
  /// walks `submitted → under-verification → verified` WITHOUT changing id, so a grant authorised
  /// before the §E verdict existed would otherwise survive into `verified` and excuse the
  /// certification of a verdict its approver never saw. A grant's justification has to carry
  /// immutable evidence of what it was justified against.
  ///
  /// NULLABLE only for rows written before this column existed — their reviewed state is not
  /// recorded and cannot be invented, so `resolveGrant` treats them as UNUSABLE rather than
  /// guessing. New grants always carry it.
  reviewedStatus           String?
  /// …and the claim's MONOTONIC lifecycle version at that moment, because the status label alone
  /// recycles. Certify ₹100 with ₹10 withheld → `certified`; approve and pay the ₹90 → `paid`;
  /// release ₹5 → `certified` again. An authorisation given at the first `certified` matches the
  /// label at the second, by which time ₹90 has been authorised and has left the practice.
  ///
  /// NULLABLE for the same reason `reviewedStatus` is: a row written before this column existed
  /// attests to nothing, and inventing a version for it would invent the evidence.
  reviewedLifecycleVersion Int?

  /// §I — a grant this release can no longer JUDGE, retired rather than left to block every
  /// deploy. Rows written before the reviewed-state columns existed carry no evidence of what
  /// their approver saw; retiring them is attributable disposal (retained, marked, named in the
  /// runbook), where an abort was an instruction nobody could carry out and deleting them would
  /// be the silent revocation the abort existed to prevent. One-way, like consumption, and
  /// available ONLY to a row that lacks reviewed evidence — a grant that carries its evidence is
  /// judged by the seals, never disposed of.
  retiredAt     DateTime?
  retiredReason String?

  grantedAt       DateTime @default(now())
  sourceCommandId String

  /// SINGLE-USE, and consumed by exactly ONE act of exactly one KIND. Both halves move together
  /// and exactly one target is named (CHECK); the transition is one-way (trigger).
  consumedAt              DateTime?
  consumedBy              BillCertificate? @relation(fields: [projectId, consumedByCertificateId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  consumedByCertificateId String?
  /// Task 6A — the payment half of §I. A grant issued for `certifier-may-not-approve` is spent by
  /// the APPROVAL it excuses, never by a certificate.
  consumedByApproval      PaymentApproval? @relation(fields: [projectId, consumedByApprovalId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  consumedByApprovalId    String?

  exceptions SodException[]

  @@unique([projectId, id])
  @@index([projectId, billId])
}

/// Phase 5 Task 5C (§H) — a DEDUCTION: money withheld from a certified payable.
///
/// **A deduction is a LEDGER ROW against a certification, never a column on it.** A column would
/// have to be updated to change, and a withholding that can be edited in place is a withholding
/// that never withheld anything — on a ₹100 certificate with ₹10 retention, quietly dropping the
/// row raises net payable to ₹100 with no attributable release. A correction is a release row.
///
/// **Amounts are strictly positive and the row TYPE carries direction.** Direction is already
/// modelled — a withholding is this row, a release is its own — so a negative amount encodes the
/// same thing twice and the two encodings disagree. A `-10` retention makes
/// `NET_PAYABLE = CERTIFIED − (−10)` raise a ₹100 certificate to ₹110: a deduction that pays out
/// MORE, sealed append-only so the inflated payable cannot be corrected in place.
///
/// `advance-recovery` is NOT in this task's type set. It folds against an `advance` row created
/// when the advance is PAID, and that is a payment fact — so the enum member arrives in Task 6
/// together with the row that caps it. Shipping it early offers only two bad options: a recovery
/// that cannot be represented, or one with no cap at all, which is a withholding against nothing.
model BillDeduction {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  /// the CERTIFICATE this withholds against. §H: a deduction is a row against a certification, so
  /// superseding that certificate takes its deductions out of every fold with it — the same live
  /// rule the consumption sets use.
  certificate   BillCertificate @relation(fields: [projectId, certificateId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  certificateId String
  /// denormalized from the certificate so the bill-scoped folds and the DB seals reach the claim
  /// without a join, and FK-bound to that same certificate's `(projectId, id, billId)` candidate
  /// key so it cannot name a different bill than its certificate does
  billId        String

  /// `retention` · `penalty` · `other` (CHECK). Every declared member is in the `NET_PAYABLE` fold.
  type   String
  amount Decimal @db.Decimal(18, 2)
  /// required for `other` and every `penalty` (CHECK), under the complete non-blank discipline —
  /// presence is not justification
  reason String?

  recordedAt      DateTime @default(now())
  recordedBy      User     @relation("billDeductionsRecorded", fields: [recordedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recordedById    String
  /// §C rule ii — every fact records the command that produced it
  sourceCommandId String

  /// §H/§F — the row on the SUPERSEDED certificate this one RE-STATES. Supersession does not
  /// discard withholdings: a retained balance that vanished without an attributable release is
  /// exactly what §H forbids, so certifying a replacement carries the live ledger forward and this
  /// column is the audit chain. Unique, so one source row can never be restated twice.
  restatedFrom   BillDeduction?  @relation("billDeductionRestatement", fields: [projectId, restatedFromId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  restatedFromId String?
  restatedAs     BillDeduction[] @relation("billDeductionRestatement")

  releases BillDeductionRelease[]

  @@unique([projectId, id])
  @@unique([projectId, restatedFromId])
  @@index([projectId, certificateId])
  @@index([projectId, billId])
}

/// Phase 5 Task 5C (§H) — RELEASING a withholding, as its own append-only row with its own
/// authority. The retained balance is a FOLD over deductions minus releases with **no stored
/// balance column** — the Phase-3 §C rule that produced a correct stock model.
model BillDeductionRelease {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  /// releases are bounded by the unreleased balance of THEIR OWN deduction, so the row names it
  deduction   BillDeduction @relation(fields: [projectId, deductionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  deductionId String

  amount Decimal @db.Decimal(18, 2)
  reason String

  releasedAt      DateTime @default(now())
  releasedBy      User     @relation("billDeductionReleases", fields: [releasedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  releasedById    String
  /// §C rule ii — every fact records the command that produced it, and R5-F3 binds that command's
  /// `resultRef` back to THIS row, so a succeeded receipt cannot be reused to append a second one
  sourceCommandId String

  /// the release row on the superseded certificate this one re-states. §H: both halves of the fold
  /// always share one scope, so releases are re-scoped WITH their deductions or the live
  /// certificate would read the retention as unreleased and claw back money already given.
  restatedFrom   BillDeductionRelease?  @relation("billReleaseRestatement", fields: [projectId, restatedFromId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  restatedFromId String?
  restatedAs     BillDeductionRelease[] @relation("billReleaseRestatement")

  @@unique([projectId, id])
  @@unique([projectId, restatedFromId])
  @@index([projectId, deductionId])
}

/// Phase 5 Task 6A (§F/§G/§I) — APPROVING money for payment. Certification says what a vendor is
/// owed; an approval is the separate authority that says it may be PAID, and §I keeps the two
/// apart deliberately: the actor who certified may not approve.
model PaymentApproval {
  /// §I — the claim's commercial revision at the moment this act was performed, so the consume
  /// seal can require an authority and the act it excuses to name the SAME passage of the claim.
  /// By COMMIT the act has already advanced the counter, so what the seal compares has to be a
  /// fact each row carries rather than one it infers. NULLABLE for rows written before it existed.
  reviewedLifecycleVersion Int?

  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  /// the CERTIFICATE this approval draws on. The three-column FK proves it is a certificate OF
  /// THIS BILL, the same shape the deduction ledger uses.
  certificate   BillCertificate @relation(fields: [projectId, certificateId, billId], references: [projectId, id, billId], onDelete: NoAction, onUpdate: NoAction)
  certificateId String
  bill          VendorBill      @relation(fields: [projectId, billId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  billId        String

  /// FROZEN money (§A `Decimal(18,2)`, half-up, never float64). §G bound 4 caps the CUMULATIVE
  /// approved total at `NET_PAYABLE` — certified minus unreleased deductions — and it is NET, not
  /// gross: capping at the gross certificate would make the §H ledger decorative.
  amount Decimal @db.Decimal(18, 2)

  approvedAt      DateTime @default(now())
  approvedBy      User     @relation("paymentApprovalsApproved", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedById    String
  /// §C rule ii — every fact records the command that produced it, and the 5C provenance rule
  /// binds that command's `resultRef` AND its actor back to THIS row
  sourceCommandId String

  payments      Payment[]
  sodExceptions SodException[]
  /// the §I grants this approval CONSUMED — at most one, and the seal requires exactly one
  /// whenever the approver is the actor who certified
  consumedGrants SodGrant[]

  @@unique([projectId, id])
  /// the FK target proving a payment and an SoD exception belong to an approval OF THIS BILL
  @@unique([projectId, id, billId])
  @@index([projectId, billId])
  @@index([projectId, certificateId])
}

/// Phase 5 Task 6A (§F/§G) — the money actually LEAVING. A payment is a row against an approval,
/// never a column on it, and §G bound 5 caps the cumulative paid total at what was approved.
model Payment {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  approval   PaymentApproval @relation(fields: [projectId, approvalId, billId], references: [projectId, id, billId], onDelete: NoAction, onUpdate: NoAction)
  approvalId String
  bill       VendorBill      @relation(fields: [projectId, billId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  billId     String

  /// FROZEN money (§A `Decimal(18,2)`, half-up, never float64)
  amount Decimal @db.Decimal(18, 2)

  /// how the money moved, so the practice can reconcile against a bank statement
  method    String
  reference String?

  paidAt          DateTime @default(now())
  paidBy          User     @relation("paymentsRecorded", fields: [paidById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paidById        String
  sourceCommandId String

  reversals PaymentReversal[]

  @@unique([projectId, id])
  @@unique([projectId, id, billId])
  @@index([projectId, billId])
  @@index([projectId, approvalId])
}

/// Phase 5 Task 6B unit ii (§0/§F/§H) — cash coming BACK, as its own append-only row.
///
/// `PAID(bill)` is Σ payments MINUS Σ payment reversals, and the reversal has to be a distinct row
/// TYPE rather than a signed amount: every append-only money row in this phase is strictly positive
/// with the type carrying direction (§H), so a positive "reversing payment" would read ₹150 paid on
/// a ₹100 bill and a negative one is refused by `Payment_amount_positive`. Neither is a reversal.
///
/// It is a row against ONE payment, never a column on it, for the same reason a release is a row
/// against one deduction: the reversed total is a FOLD with no stored balance to drift. The
/// three-column FK proves the payment it reverses is a payment OF THIS BILL, so `billId` — which
/// the bill-scoped fold and the §F derivation seal both read — cannot disagree with it.
/// Phase 5 Task 6C (§H) — money paid to a vendor BEFORE any bill certifies it, and the pool that
/// `advance-recovery` deductions draw down.
///
/// It is deliberately NOT a `Payment`. A payment is nested under a `PaymentApproval` on a
/// `BillCertificate` — that is what makes §G bound 5 (`PAID ≤ APPROVED`) askable — and an advance
/// has neither: it is paid against the commercial relationship, not against a certified claim. A
/// row here must therefore never enter `PAID(bill)`, or a mobilisation advance would read as
/// payment of a bill nobody has certified.
///
/// VENDOR-scoped through the same `ProjectVendor` binding a bill uses (§H tenancy), so an advance
/// paid to one counterparty can never be recovered from another's claim.
model VendorAdvance {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  binding  ProjectVendor @relation(fields: [projectId, vendorId], references: [projectId, vendorId], onDelete: NoAction, onUpdate: NoAction)
  vendorId String

  /// FROZEN money (§A `Decimal(18,2)`, half-up, never float64). STRICTLY POSITIVE: §H gives every
  /// append-only money row in this phase a positive amount with the row TYPE carrying direction.
  amount Decimal @db.Decimal(18, 2)

  /// what the advance is FOR — mobilisation, materials, a specific milestone. Required: an advance
  /// is a commercial commitment recovered over later bills, and one nobody can explain is a
  /// payment with no story attached to it.
  reason String

  /// how the money moved, so the practice can reconcile against a bank statement — the same pair
  /// `Payment` carries, because this is cash leaving by the same route
  method    String
  reference String?

  paidAt          DateTime @default(now())
  paidBy          User     @relation("advancesPaid", fields: [paidById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paidById        String
  sourceCommandId String

  @@unique([projectId, id])
  @@index([projectId, vendorId])
}

model PaymentReversal {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  payment   Payment    @relation(fields: [projectId, paymentId, billId], references: [projectId, id, billId], onDelete: NoAction, onUpdate: NoAction)
  paymentId String
  bill      VendorBill @relation(fields: [projectId, billId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  billId    String

  /// FROZEN money (§A `Decimal(18,2)`, half-up, never float64). STRICTLY POSITIVE, and bounded by
  /// what its own payment actually paid — cumulatively, so two part-reversals cannot exceed it.
  amount Decimal @db.Decimal(18, 2)

  /// why the money came back. Recovering cash is its own attributable act (§0), never a side effect
  /// of correcting a document, so the reason is required rather than optional.
  reason String

  reversedAt      DateTime @default(now())
  reversedBy      User     @relation("paymentsReversed", fields: [reversedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversedById    String
  sourceCommandId String

  @@unique([projectId, id])
  @@index([projectId, billId])
  @@index([projectId, paymentId])
}
