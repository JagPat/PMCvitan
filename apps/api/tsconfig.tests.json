{
  // Type-checks the api's test files. tsconfig.json leaves out src/**/*.test.ts and test/, and tsconfig.contracts.json
  // checks only five of the contract tests, so a test could stop compiling and no gate would say so. This config checks
  // every test file, and the src it imports, with the module settings vitest runs them under. It is run by
  // test/typecheck-ratchet.mjs, the third step of `pnpm --filter api typecheck`, which holds each file to the diagnostics
  // test/typecheck-baseline.json lists for it, each with a count: a diagnostic not listed for a file fails, a listed one
  // may not occur more often, and one that occurs less often fails until its count is lowered in the same change.
  // A diagnostic includes the types tsc prints, so an unrelated change can re-key one and its entry must be re-listed;
  // against the base branch the baseline is compared per file and per error code, so that edit can be made. Imported src is checked here
  // under bundler resolution too, so a src construct only commonjs accepts fails this step.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "incremental": false,
    "noEmit": true
  },
  "include": ["src/**/*.test.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
